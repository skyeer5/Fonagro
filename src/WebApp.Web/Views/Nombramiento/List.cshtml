@using WebApp.Application.Nombramientos.Queries.GetNomParaAprobar
@model WebApp.Application.Core.PagedList<GetNomParaAprobarResponse>;

@{
    ViewData["Title"] = "Listado de Nombramientos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Nombramientos</h2>
        <a href="/Nombramiento/Crear" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nuevo Nombramiento
        </a>
    </div>

    <!-- Tabla de comisiones -->
    <div class="table-responsive">
        <table class="table table-hover align-middle shadow-sm">
            <thead class="bg-azul">
                <tr>
                    <th>Nombre del Nombrado</th>
                    <th>Correlativo</th>
                    <th>Fecha salida</th>
                    <th>Fecha regreso</th>
                    <th>Proposito</th>
                    <th>Creador del nombramiento</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.Items)
                {
                    <tr>
                        <td>@item.Nombre_Nombrado</td>
                        <td>@item.Correlativo</td>
                        <td>@item.Fecha_Salida.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Fecha_Regreso.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Proposito</td>
                        <td>@item.Nombre_Creador_Nombramiento</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/Nombramiento/List?currentPage=@(Model.CurrentPage != 1 ? Model.CurrentPage-1 : Model.CurrentPage)">Atrás</a>
            </li>
            @for(int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" href="/Nombramiento/List?currentPage=@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="/Nombramiento/List?currentPage=@(Model.CurrentPage != Model.TotalPages ? Model.CurrentPage+1 : Model.CurrentPage)">Siguiente</a>
            </li>
        </ul>
    </nav>

    <div class="mt-3">
        <a href="/Home/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Atrás
        </a>
    </div>
</div>

<script>
</script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
