@using WebApp.Application.Nombramientos.Queries.GetNombramientos
@using WebApp.Domain.Nombramientos
@model WebApp.Application.Core.PagedList<GetNombramientosResponse>;

@{
    ViewData["Title"] = "Listado de Nombramientos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Nombramientos</h2>
        <a href="/Nombramiento/Crear" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nuevo Nombramiento
        </a>
    </div>
    <!-- Barra de búsqueda -->
    <form action="/Nombramiento/List" method="get" class="mb-4">
        <div class="row g-3 align-items-end">

            <!-- Buscar por nombre -->
            <div class="col-md-3">
                <label for="nombre_nombrado" class="form-label fw-bold">
                    <i class="bi bi-pin-map"></i> Nombre del nombrado
                </label>
                <input type="text" 
                    class="form-control shadow-sm" 
                    id="nombre_nombrado" 
                    name="nombre_nombrado" 
                    placeholder="Ej. Daniel Pineda">
            </div>

            <!-- Fecha de inicio -->
            <div class="col-md-2">
                <label for="fecha_inicio" class="form-label fw-bold">
                    <i class="bi bi-calendar-event"></i> Fecha Inicio
                </label>
                <input type="date" 
                    class="form-control shadow-sm" 
                    id="fecha_inicio" 
                    name="fecha_inicio">
            </div>

            <!-- Fecha de fin -->
            <div class="col-md-2">
                <label for="fecha_fin" class="form-label fw-bold">
                    <i class="bi bi-calendar-check"></i> Fecha Fin
                </label>
                <input type="date" 
                    class="form-control shadow-sm" 
                    id="fecha_fin" 
                    name="fecha_fin">
            </div>
            <!-- Estado -->
            <div class="col-md-2">
                <label for="estado" class="form-label fw-bold">
                    <i class="bi bi-tag"></i> Estado
                </label>
                <select name="Estado" id="estado" class="form-control">
                    <option value="">Seleccionar estado</option>
                    @foreach (SelectListItem estado in ViewBag.Estados)
                    {
                        <option value="@estado.Value">@estado.Text</option>
                    }
                </select>
            </div>
            <!-- Unidades -->
            <div class="col-md-2">
                <label for="unidad" class="form-label fw-bold">
                    <i class="bi bi-tag"></i> Unidad
                </label>
                <select name="unidad" id="unidad" class="form-control">
                    <option value="">Seleccionar unidad</option>
                    @foreach (SelectListItem unidad in ViewBag.Unidades)
                    {
                        <option value="@unidad.Value">@unidad.Text</option>
                    }
                </select>
            </div>

            <div class="col-md-1">
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i> Buscar
            </button>
            </div>

        </div>

        
    </form>
    <!-- Tabla de comisiones -->
    <div class="table-responsive">
        <table class="table table-hover align-middle shadow-sm">
            <thead class="bg-azul">
                <tr>
                    <th>Correlativo</th>
                    <th>Nombre del Nombrado</th>
                    <th>Fecha salida</th>
                    <th>Fecha regreso</th>
                    <th>Departamentos y Municipios</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.Items)
                {
                    <tr>
                        <td class="text-nowrap">@item.Correlativo</td>
                        <td>@item.Nombre_Nombrado</td>
                        <td>@item.Fecha_Salida.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Fecha_Regreso.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-nowrap">
                            @foreach (var dest in item.DepartamentosYMunicipios!)
                            {
                                <div>@dest</div>
                            }
                        </td>
                        <td>@item.Estado</td>
                        <td class="text-center">
                            <div class="d-flex flex-column align-items-center">
                            @if(item.Estado == NombramientoEstados.Creado)
                            {
                                <a href="/Comision/Edit?id=@item.NombramientoId" class="btn btn-sm btn-outline-primary mb-2">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>

                                <form id="formAprobarNombramiento" asp-action="Aprobar" asp-controller="Nombramiento" method="post" class="mb-2">
                                    <input type="hidden" name="NombramientoId" value="@item.NombramientoId" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-x-circle"></i> Aprobar
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary btn-imprimir"
                                        data-id="@item.NombramientoId">
                                    <i class="bi bi-eye"></i> Imprimir
                                </button>
                            }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/Nombramiento/List?currentPage=@(Model.CurrentPage != 1 ? Model.CurrentPage-1 : Model.CurrentPage)">Atrás</a>
            </li>
            @for(int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" href="/Nombramiento/List?currentPage=@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages || Model.TotalPages == 0 ? "disabled" : "")">
                <a class="page-link" href="/Nombramiento/List?currentPage=@(Model.CurrentPage != Model.TotalPages ? Model.CurrentPage+1 : Model.CurrentPage)">Siguiente</a>
            </li>
        </ul>
    </nav>

    <div class="mt-3">
        <a href="/Home/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Atrás
        </a>
    </div>

    <!-- Modal de generación de PDF -->
    <div class="modal fade" id="modalGenerandoPdf" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">
                <div class="modal-body">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Generando...</span>
                    </div>
                    <h5 class="fw-bold">Generando el PDF</h5>
                    <p class="text-muted mb-0">Esto puede tardar unos segundos, por favor espera...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmarNombramientoModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar comisión</h5>
            </div>
            <div class="modal-body">
                ¿Está seguro de aprobar el nombramiento?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarNombramiento" class="btn btn-primary">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
<script>
    const modalGenerandoPdf = new bootstrap.Modal(document.getElementById('modalGenerandoPdf'));

    document.querySelectorAll('.btn-imprimir').forEach(btn => {
        btn.addEventListener('click', () => generarPdf(btn.dataset.id));
    });

    async function generarPdf(nombramientoId) {
        modalGenerandoPdf.show();

        try {
            const response = await fetch(`/Nombramiento/Imprimir?nombramientoId=${nombramientoId}`);

            if (!response.ok) {
                throw new Error(`Error del servidor: ${response.status}`);
            }

            // 1. Extraer el nombre del archivo desde la cabecera Content-Disposition
            let filename = `nombramiento-${nombramientoId}.pdf`; // Nombre por defecto (fallback)
            const disposition = response.headers.get('Content-Disposition');

            if (disposition && disposition.includes('filename')) {
                const filenameMatch = disposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                if (filenameMatch && filenameMatch[1]) {
                    // Limpiar comillas extras si vienen en la cabecera
                    filename = filenameMatch[1].replace(/['"]/g, '');
                }
            }

            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);

            // 2. Forzar descarga con el nombre obtenido del servidor
            const link = document.createElement('a');
            link.href = url;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            window.URL.revokeObjectURL(url);

        } catch (error) {
            alert('No se pudo generar el PDF. Intenta de nuevo. ' + error.message);
        } finally {
            modalGenerandoPdf.hide();
        }
    }
    // =====================================================
    // MODAL DE CONFIRMACIÓN
    // =====================================================
    const formularioNom = document.getElementById("formAprobarNombramiento");
    const modalElement = document.getElementById("confirmarNombramientoModal");
    const btnConfirmarNom = document.getElementById("btnConfirmarNombramiento");

    let formularioConfirmado = false;

    formularioNom.addEventListener("submit", function (event) {
        if (formularioConfirmado) {
            return;
        }

        // Si faltan campos requeridos por llenar, deja actuar a la validación de HTML5
        if (!formularioNom.checkValidity()) {
            return;
        }

        event.preventDefault();

        // Aquí ya no dará error porque Bootstrap ya está cargado
        const modalConfirmacion = bootstrap.Modal.getOrCreateInstance(modalElement);
        modalConfirmacion.show();
    });

    btnConfirmarNom.addEventListener("click", function () {
        formularioConfirmado = true;
        formularioNom.requestSubmit();
    });
</script>
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
