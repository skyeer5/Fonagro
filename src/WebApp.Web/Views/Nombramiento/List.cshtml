@using WebApp.Application.Nombramientos.Queries.GetNombramientos
@using WebApp.Domain.Nombramientos
@model WebApp.Web.Models.Nombramientos.NombramientoListViewModel;

@{
    ViewData["Title"] = "Listado de Nombramientos";
    var routeData = new Dictionary<string, string>();
    if(Model.Usuario.HasValue)
        routeData["usuario"] = Model.Usuario.Value.ToString();

    if(Model.Correlativo.HasValue)
        routeData["correlativo"] = Model.Correlativo.Value.ToString();

    if(Model.Fecha_Inicio.HasValue)
        routeData["fecha_inicio"] = Model.Fecha_Inicio.Value.ToString("yyyy-MM-dd");

    if(Model.Fecha_Fin.HasValue)
        routeData["fecha_inicio"] = Model.Fecha_Fin.Value.ToString("yyyy-MM-dd");

    if(Model.Estado.HasValue)
        routeData["estado"] = Model.Estado.Value.ToString();

    if(Model.Unidad.HasValue)
        routeData["unidad"] = Model.Unidad.Value.ToString();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Nombramientos</h2>
        <a href="/Nombramiento/Crear" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nuevo Nombramiento
        </a>
    </div>
    <!-- Barra de búsqueda -->
    <form action="/Nombramiento/List" method="get" class="mb-4">
        <div class="row g-3 align-items-stretch">
            
            <div class="col-md-11">
                
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label for="UsuarioId" class="form-label fw-bold">
                            <i class="bi bi-people"></i> Usuario
                        </label>
                        <select asp-for="Usuario" asp-items="Model.UsuariosList" id="UsuarioId" class="form-select select2-single">
                            <option value="">Seleccionar usuario</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="unidad" class="form-label fw-bold">
                            <i class="bi bi-diagram-3"></i> Unidad
                        </label>
                        <select name="unidad" id="unidad" class="form-select">
                            <option value="">Seleccionar unidad</option>
                            @foreach (SelectListItem unidad in Model.UnidadList)
                            {
                                <option value="@unidad.Value">@unidad.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="correlativo" class="form-label fw-bold">
                            <i class="bi bi-hash"></i> Correlativo
                        </label>
                        <input asp-for="Correlativo" type="number" class="form-control shadow-sm" id="correlativo" name="correlativo">
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="fecha_inicio" class="form-label fw-bold">
                            <i class="bi bi-calendar-event"></i> Fecha Inicio
                        </label>
                        <input asp-for="Fecha_Inicio" type="date" class="form-control shadow-sm" id="fecha_inicio" name="fecha_inicio">
                    </div>
                    <div class="col-md-4">
                        <label for="fecha_fin" class="form-label fw-bold">
                            <i class="bi bi-calendar-check"></i> Fecha Fin
                        </label>
                        <input asp-for="Fecha_Fin" type="date" class="form-control shadow-sm" id="fecha_fin" name="fecha_fin">
                    </div>
                    <div class="col-md-4">
                        <label for="estado" class="form-label fw-bold">
                            <i class="bi bi-tag"></i> Estado
                        </label>
                        <select asp-for="Estado" name="Estado" id="estado" class="form-select">
                            <option value="">Seleccionar estado</option>
                            @foreach (SelectListItem estado in Model.EstadoList)
                            {
                                <option value="@estado.Value">@estado.Text</option>
                            }
                        </select>
                    </div>
                </div>

            </div>

            <div class="col-md-1 d-flex align-items-center justify-content-center">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-search"></i> Buscar
                </button>
            </div>

        </div>
    </form>


    <!-- Tabla de comisiones -->
    <div class="table-responsive">
        <table class="table table-hover align-middle shadow-sm">
            <thead class="bg-azul">
                <tr>
                    <th>Correlativo</th>
                    <th>Nombre del Nombrado</th>
                    <th>Fecha salida</th>
                    <th>Fecha regreso</th>
                    <th>Departamentos y Municipios</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.NombramientosList)
                {
                    <tr>
                        <td class="text-nowrap">@item.Correlativo</td>
                        <td>@item.Nombre_Nombrado</td>
                        <td>@item.Fecha_Salida</td>
                        <td>@item.Fecha_Regreso</td>
                        <td class="text-nowrap">
                            @foreach (var dest in item.DepartamentosYMunicipios!)
                            {
                                <div>@dest</div>
                            }
                        </td>
                        <td>@item.Estado</td>
                        <td class="text-nowrap">
                            <div class="d-flex flex-column align-items-center">
                                <a href="/Nombramiento/VerDetalle?nombramientoId=@item.NombramientoId" class="btn btn-sm btn-outline-success mb-2">
                                    <i class="bi bi-eye"></i> Detalles
                                </a>
                            @if(item.Estado != NombramientoEstados.Creado)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary btn-imprimir"
                                        data-id="@item.NombramientoId">
                                    <i class="bi bi-download"></i> Imprimir
                                </button>

                            }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    @if (Model.TotalPages > 0)
    {
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                @{
                    var prevRoute = new Dictionary<string, string>(routeData){["currentPage"] = (Model.CurrentPage - 1).ToString()};
                }
                <a class="page-link" asp-controller="Nombramiento" asp-action="List" asp-all-route-data="prevRoute">Atrás</a>
            </li>
            @for(int i = 1; i <= Model.TotalPages; i++)
            {
                var pageRoute = new Dictionary<string, string>(routeData){["currentPage"] = i.ToString()};
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-controller="Nombramiento" asp-action="List" asp-all-route-data="pageRoute">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                @{
                    var nextRoute = new Dictionary<string, string>(routeData){["currentPage"] = (Model.CurrentPage + 1).ToString()};
                }
                <a class="page-link" asp-controller="Nombramiento" asp-action="List" asp-all-route-data="nextRoute">Siguiente</a>
            </li>
        </ul>
    </nav>
    }
    <div class="mt-3">
        <a href="/Home/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Atrás
        </a>
    </div>

    <!-- Modal de generación de PDF -->
    <div class="modal fade" id="modalGenerandoPdf" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">
                <div class="modal-body">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Generando...</span>
                    </div>
                    <h5 class="fw-bold">Generando el PDF</h5>
                    <p class="text-muted mb-0">Esto puede tardar unos segundos, por favor espera...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmarNombramientoModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar comisión</h5>
            </div>
            <div class="modal-body">
                ¿Está seguro de aprobar el nombramiento?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarNombramiento" class="btn btn-primary">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
<script>
    const modalGenerandoPdf = new bootstrap.Modal(document.getElementById('modalGenerandoPdf'));
        $(document).ready(function () {
            // Inicialización de componentes Select2
            $('.select2').select2({ placeholder: "Seleccione opciones...", allowClear: true, width: '100%' });
            $('.select2-single').select2({ placeholder: "Seleccione una opción", allowClear: true, width: '100%' });
        });
    document.querySelectorAll('.btn-imprimir').forEach(btn => {
        btn.addEventListener('click', () => generarPdf(btn.dataset.id));
    });

    async function generarPdf(nombramientoId) {
        modalGenerandoPdf.show();

        try {
            const response = await fetch(`/Nombramiento/Imprimir?nombramientoId=${nombramientoId}`);

            if (!response.ok) {
                throw new Error(`Error del servidor: ${response.status}`);
            }

            // 1. Extraer el nombre del archivo desde la cabecera Content-Disposition
            let filename = `nombramiento-${nombramientoId}.pdf`; // Nombre por defecto (fallback)
            const disposition = response.headers.get('Content-Disposition');

            if (disposition && disposition.includes('filename')) {
                const filenameMatch = disposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                if (filenameMatch && filenameMatch[1]) {
                    // Limpiar comillas extras si vienen en la cabecera
                    filename = filenameMatch[1].replace(/['"]/g, '');
                }
            }

            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);

            // 2. Forzar descarga con el nombre obtenido del servidor
            const link = document.createElement('a');
            link.href = url;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            window.URL.revokeObjectURL(url);

        } catch (error) {
            alert('No se pudo generar el PDF. Intenta de nuevo. ' + error.message);
        } finally {
            modalGenerandoPdf.hide();
        }
    }
    // =====================================================
    // MODAL DE CONFIRMACIÓN
    // =====================================================
    const formularioNom = document.getElementById("formAprobarNombramiento");
    const modalElement = document.getElementById("confirmarNombramientoModal");
    const btnConfirmarNom = document.getElementById("btnConfirmarNombramiento");

    let formularioConfirmado = false;

    formularioNom.addEventListener("submit", function (event) {
        if (formularioConfirmado) {
            return;
        }

        // Si faltan campos requeridos por llenar, deja actuar a la validación de HTML5
        if (!formularioNom.checkValidity()) {
            return;
        }

        event.preventDefault();

        // Aquí ya no dará error porque Bootstrap ya está cargado
        const modalConfirmacion = bootstrap.Modal.getOrCreateInstance(modalElement);
        modalConfirmacion.show();
    });

    btnConfirmarNom.addEventListener("click", function () {
        formularioConfirmado = true;
        formularioNom.requestSubmit();
    });
</script>
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
