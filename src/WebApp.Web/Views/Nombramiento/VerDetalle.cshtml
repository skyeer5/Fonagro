@model WebApp.Web.Models.Nombramientos.NombramientoVerDetalleViewModel;

@{
    ViewData["Title"] = "Actualizar Nombramiento";
}

<div class="container-fluid px-0 max-w-4xl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold azul mb-1">Actualizar Nombramiento</h2>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form id="formEditarNombramiento" asp-action="Editar" method="post" novalidate>
                
                <input type="hidden" asp-for="NombramientoId" />

                <!-- Sección 1: Información General -->
                <div class="border-bottom pb-3 mb-4">
                    <h6 class="text-uppercase text-primary fw-bold fs-7 mb-3 azul">1. Información General</h6>
                    <div class="row g-3">
                        <div class="col-4 ">
                            <label class="form-label fw-semibold">Usuario</label>
                            <input value="@Model.Nombre_Completo" class="form-control" disabled />
                        </div>
                        <div class="col-4 ">
                            <label class="form-label fw-semibold">Correlativo</label>
                            <input value="@Model.Correlativo" class="form-control" disabled />
                        </div>
                        <div class="col-4 ">
                            <label class="form-label fw-semibold">Estado</label>
                            <input value="@Model.NombramientoEstado" class="form-control" disabled />
                        </div>

                        <div class="col-12">
                            <label asp-for="Proposito" class="form-label fw-semibold">Propósito de la comisión <span class="text-danger">*</span></label>
                            <textarea asp-for="Proposito" class="form-control" rows="3" placeholder="Describa el propósito..." required></textarea>
                            <span asp-validation-for="Proposito" class="invalid-feedback d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Sección 2: Ubicación Geográfica -->
                <div class="border-bottom pb-3 mb-4">
                    <h6 class="text-uppercase text-primary fw-bold fs-7 mb-3 azul">2. Ubicaciones</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Departamentos</label>
                            <select id="DepartamentoId" asp-items="Model.DepartamentoList" multiple="multiple" class="form-select select2-multi">
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Municipios" class="form-label fw-semibold">Municipios <span class="text-danger">*</span></label>
                            <select asp-for="Municipios" id="MunicipioId" asp-items="Model.MunicipioList" multiple="multiple" class="form-select select2-multi" required>
                            </select>
                            <span asp-validation-for="Municipios" class="invalid-feedback d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Sección 3: Programación de Fechas -->
                <div class="border-bottom pb-3 mb-4">
                    <h6 class="text-uppercase text-primary fw-bold fs-7 mb-3 azul">3. Fechas y Horarios</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Fecha_Salida" class="form-label fw-semibold">Fecha de Salida <span class="text-danger">*</span></label>
                            <input asp-for="Fecha_Salida" id="Fecha_Salida" type="date" class="form-control" required 
                                   value="@( Model.Fecha_Salida.ToString("yyyy-MM-dd"))"/>
                            <span asp-validation-for="Fecha_Salida" class="invalid-feedback d-block"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Fecha_Regreso" class="form-label fw-semibold">Fecha de Regreso <span class="text-danger">*</span></label>
                            <input asp-for="Fecha_Regreso" id="Fecha_Regreso" type="date" class="form-control" required 
                                   value="@(Model.Fecha_Regreso.ToString("yyyy-MM-dd"))"/>
                            <span asp-validation-for="Fecha_Regreso" class="invalid-feedback d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Sección 4: Información de la comisión asignada -->
                <div class="mb-4">
                    <h6 class="text-uppercase text-primary fw-bold fs-7 mb-3 azul">4. Comisión asignada</h6>
                    <div class="row g-3">
                        @if(Model.ComisionId == null)
                        {
                            <div class="col-12">
                                <label class="form-label fw-semibold">El nombramiento no se encuentra vinculado a ninguna comisión </label>
                            </div>
                        }
                        else
                        {
                            <div class="col-6">
                                <label class="form-label fw-semibold">El nombramiento se encuentra asignado a la comisión con estado @Model.ComisionEstado</label>
                                <a asp-action="List" class="btn btn-success btn-sm">
                                    <i class="bi bi-arrow-left me-1"></i> Ver Comisión
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="List" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Atrás
                    </a>
                    <a asp-action="List" class="btn btn-danger px-4">Cancelar</a>
                    @if(Model.NombramientoEstado != WebApp.Domain.Nombramientos.NombramientoEstados.Creado)
                    {
                        <button type="submit" class="btn btn-warning text-white px-4 bg-azul">
                            <i class="bi bi-pencil-square me-1"></i> Guardar Cambios
                        </button>
                    }
                    else
                    {
                        <button type="submit" form="formAprobarNombramiento" class="btn btn-success">
                            <i class="bi bi-check-circle me-1"></i> Aprobar
                        </button>
                    }
                </div>
            </form>

            @if(Model.NombramientoEstado == WebApp.Domain.Nombramientos.NombramientoEstados.Creado)
            {
                <form id="formAprobarNombramiento" asp-action="Aprobar" asp-controller="Nombramiento" method="post" class="d-none">
                    <input type="hidden" name="NombramientoId" value="@Model.NombramientoId" />
                </form>
            }
        </div>
    </div>
</div>

<!-- Modal de Confirmación Edición -->
<div class="modal fade" id="confirmarEdicionModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Confirmar modificación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="mb-0 text-muted">¿Está seguro de guardar las modificaciones en este nombramiento?</p>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarEdicion" class="btn btn-warning text-white px-4 bg-azul">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Confirmación Aprobar -->
<div class="modal fade" id="confirmarNombramientoModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar comisión</h5>
            </div>
            <div class="modal-body">
                ¿Está seguro de aprobar el nombramiento?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarNombramiento" class="btn btn-primary">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    $(document).ready(function () {
        // Inicialización de Select2
        $('.select2-single').select2({ placeholder: "Seleccione una opción", allowClear: true, width: '100%' });
        $('.select2-multi').select2({ placeholder: "Seleccione opciones", allowClear: true, width: '100%' });

        // Carga dinámica de municipios SOLO cuando el usuario cambia la selección de departamentos
        $('#DepartamentoId').on('change', async function (e) {
            if (!e.originalEvent) return;

            const deptoIds = $(this).val();
            const $municipioSelect = $('#MunicipioId');
            
            $municipioSelect.empty().trigger('change');

            if (!deptoIds || deptoIds.length === 0) return;

            try {
                const queryParams = deptoIds.map(id => `departamentosIds=${id}`).join('&');
                const response = await fetch(`/Municipio/GetMunicipiosByDepartamentosIds?${queryParams}`);
                
                if (response.ok) {
                    const data = await response.json();
                    const municipios = Array.isArray(data) ? data : (data.value || data.data || []);

                    municipios.forEach(m => {
                        $municipioSelect.append(new Option(m.nombre, m.id, false, false));
                    });

                    $municipioSelect.trigger('change');
                }
            } catch (err) {
                console.error("Error al cargar municipios:", err);
            }
        });

        // =====================================================
        // MODAL EDICIÓN
        // =====================================================
        const $form = $('#formEditarNombramiento');
        const modalEdicion = document.getElementById("confirmarEdicionModal");
        const btnConfirmar = document.getElementById("btnConfirmarEdicion");
        let formularioConfirmado = false;

        $form.on("submit", function (event) {
            if (formularioConfirmado) return;

            if (($form.valid && !$form.valid()) || !this.checkValidity()) {
                return;
            }

            event.preventDefault();
            bootstrap.Modal.getOrCreateInstance(modalEdicion).show();
        });

        if (btnConfirmar) {
            btnConfirmar.addEventListener("click", function () {
                formularioConfirmado = true;
                $form[0].requestSubmit();
            });
        }

        // =====================================================
        // MODAL APROBACIÓN
        // =====================================================
        const formularioNom = document.getElementById("formAprobarNombramiento");
        const modalAprobacion = document.getElementById("confirmarNombramientoModal");
        const btnConfirmarNom = document.getElementById("btnConfirmarNombramiento");

        let formularioAprobarConfirmado = false;

        if (formularioNom) {
            formularioNom.addEventListener("submit", function (event) {
                if (formularioAprobarConfirmado) return;

                event.preventDefault();
                const modalConfirmacion = bootstrap.Modal.getOrCreateInstance(modalAprobacion);
                modalConfirmacion.show();
            });
        }

        if (btnConfirmarNom) {
            btnConfirmarNom.addEventListener("click", function () {
                formularioAprobarConfirmado = true;
                formularioNom.requestSubmit();
            });
        }
    });
    </script>
}