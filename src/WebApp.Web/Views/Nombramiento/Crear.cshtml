@model WebApp.Web.Models.Nombramientos.NombramientoCreateViewModel;

@{
    ViewData["Title"] = "Crear Nombramiento";
}

<div class="container-fluid px-0 max-w-4xl">
    <!-- Encabezado de Página -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold azul mb-1">Crear Nombramiento</h2>
        </div>
    </div>

    <!-- Tarjeta Principal -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form id="formCrearNombramiento" asp-action="Crear" method="post" novalidate>
                
                <!-- Sección 1: Información General -->
                <div class="border-bottom pb-3 mb-4">
                    <h6 class="text-uppercase text-primary fw-bold fs-7 mb-3 azul">1. Información General</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="UsuarioId" class="form-label fw-semibold">Usuario <span class="text-danger">*</span></label>
                            <select asp-for="UsuarioId" asp-items="Model.Usuarios" class="form-select select2-single" required>
                                <option value="">Seleccione un usuario...</option>
                            </select>
                            <span asp-validation-for="UsuarioId" class="invalid-feedback d-block"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Proposito" class="form-label fw-semibold">Propósito de la comisión <span class="text-danger">*</span></label>
                            <textarea asp-for="Proposito" class="form-control" rows="3" placeholder="Describa brevemente el objetivo..." required></textarea>
                            <span asp-validation-for="Proposito" class="invalid-feedback d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Sección 2: Ubicación Geográfica -->
                <div class="border-bottom pb-3 mb-4">
                    <h6 class="text-uppercase text-primary fw-bold fs-7 mb-3 azul">2. Ubicación y Cobertura</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Departamentos" class="form-label fw-semibold">Departamentos</label>
                            <select asp-for="Departamentos" id="DepartamentoId" asp-items="Model.Departamentos" multiple="multiple" class="form-select select2-multi">
                            </select>
                            <span asp-validation-for="Departamentos" class="invalid-feedback d-block"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Municipios" class="form-label fw-semibold">Municipios</label>
                            <select asp-for="Municipios" id="MunicipioId" multiple="multiple" class="form-select select2-multi">
                            </select>
                            <span asp-validation-for="Municipios" class="invalid-feedback d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Sección 3: Programación de Fechas -->
                <div class="mb-4">
                    <h6 class="text-uppercase text-primary fw-bold fs-7 mb-3 azul">3. Fechas</h6>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Fecha_Salida" class="form-label fw-semibold">Fecha de Salida <span class="text-danger">*</span></label>
                            <input asp-for="Fecha_Salida" id="Fecha_Salida" type="date" class="form-control" required 
                                   value="@(Model?.Fecha_Salida != DateOnly.MinValue ? Model?.Fecha_Salida.ToString("yyyy-MM-dd") : "")"/>
                            <span asp-validation-for="Fecha_Salida" class="invalid-feedback d-block"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Fecha_Regreso" class="form-label fw-semibold">Fecha Regreso <span class="text-danger">*</span></label>
                            <input asp-for="Fecha_Regreso" id="Fecha_Regreso" type="date" class="form-control" required 
                                   value="@(Model?.Fecha_Regreso != DateOnly.MinValue ? Model?.Fecha_Regreso.ToString("yyyy-MM-dd") : "")"/>
                            <span asp-validation-for="Fecha_Regreso" class="invalid-feedback d-block"></span>
                        </div>
                    </div>
                </div>

                <!-- Botones de Acción -->
                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="List" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Atrás
                    </a>
                    <button type="submit" class="btn bg-azul px-4">
                        <i class="bi bi-check-lg me-1"></i> Crear Nombramiento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal de Confirmación -->
<div class="modal fade" id="confirmarNombramientoModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Confirmar creación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="mb-0 text-muted">¿Está seguro de que desea registrar este nombramiento con los datos ingresados?</p>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarNombramiento" class="btn btn-primary px-4">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    $(document).ready(function () {
        // Inicialización Select2
        $('.select2-single').select2({ placeholder: "Seleccione un usuario", allowClear: true, width: '100%' });
        $('.select2-multi').select2({ placeholder: "Seleccione opciones", allowClear: true, width: '100%' });

        // Cascading Dropdown (Departamentos -> Municipios)
        $('#DepartamentoId').on('change', async function () {
            const deptoIds = $(this).val();
            const $municipioSelect = $('#MunicipioId');
            $municipioSelect.empty().trigger('change');

            if (!deptoIds || deptoIds.length === 0) return;

            try {
                const queryParams = deptoIds.map(id => `departamentosIds=${id}`).join('&');
                const response = await fetch(`/Municipio/GetMunicipiosByDepartamentosIds?${queryParams}`);
                
                if (response.ok) {
                    const data = await response.json();
                    const municipios = Array.isArray(data) ? data : (data.value || data.data || []);

                    municipios.forEach(m => {
                        $municipioSelect.append(new Option(m.nombre, m.id, false, false));
                    });
                    $municipioSelect.trigger('change');
                }
            } catch (err) {
                console.error("Error al cargar municipios:", err);
            }
        });

        // Validación y Confirmación de Modal
        const $form = $('#formCrearNombramiento');
        const modalElement = document.getElementById("confirmarNombramientoModal");
        const btnConfirmarNom = document.getElementById("btnConfirmarNombramiento");
        let formularioConfirmado = false;

        $form.on("submit", function (event) {
            if (formularioConfirmado) return;

            if (($form.valid && !$form.valid()) || !this.checkValidity()) {
                return;
            }

            event.preventDefault();
            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        });

        btnConfirmarNom.addEventListener("click", function () {
            formularioConfirmado = true;
            $form[0].requestSubmit();
        });
    });
    </script>
}