@model IEnumerable<WebApp.Application.GasolinaPrecios.Command.GasolinaPrecioCreate.GasolinaPrecioCreateRequest>;

@{
    ViewData["Title"] = "Actualizar Precio de Gasolina";
    var gasolinas = ViewBag.Gasolinas as IEnumerable<WebApp.Application.Gasolinas.Queries.GetGasolinasWithPrecio.GetGasolinasWithPrecioResponse>;
}

<h2>Actualizar Precio de Combustible</h2>

<form asp-action="UpdatePrecio" method="post">
    <div class="form-group">
        <label for="GasolinaId">Combustible</label>
        <select id="GasolinaId" name="GasolinaId" class="form-control" required>
            <option value="">-- Seleccione un combustible --</option>
            @foreach (var g in gasolinas!)
            {
                <option value="@g.Id">@g.Nombre - Precio actual: @(g.Precio?.ToString("C"))</option>
            }
        </select>
    </div>

    <div class="form-group mt-3">
        <label for="Precio">Nuevo Precio</label>
        <input type="number" step="0.01" id="Precio" name="Precio" class="form-control" placeholder="Ingrese nuevo precio" required />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Guardar</button>
</form>
