@model WebApp.Web.Models.Comisiones.AprobarCombustibleViewModel

@{
    ViewBag.Title = "Comisión - Combustible";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Comisiones - Combustible</h2>
    </div>
    <form action="/Comision/AprobarCombustible" method="get" class="mb-4">
        <div class="row g-3 align-items-end">
            <!-- Fecha de inicio -->
            <div class="col-md-3">
                <label for="fecha_inicio" class="form-label fw-bold">
                    <i class="bi bi-calendar-event"></i> Fecha Inicio
                </label>
                <input type="date" 
                    class="form-control shadow-sm" 
                    id="fecha_inicio" 
                    name="fecha_inicio">
            </div>

            <!-- Fecha de fin -->
            <div class="col-md-3">
                <label for="fecha_fin" class="form-label fw-bold">
                    <i class="bi bi-calendar-check"></i> Fecha Fin
                </label>
                <input type="date" 
                    class="form-control shadow-sm" 
                    id="fecha_fin" 
                    name="fecha_fin">
            </div>
            <!-- Estado -->
            <div class="col-md-3">
                <label for="estado" class="form-label fw-bold">
                    <i class="bi bi-tag"></i> Estado
                </label>
                <select name="Estado" id="estado" class="form-control">
                    @foreach (SelectListItem estado in Model.EstadosList)
                    {
                        <option value="@estado.Value">@estado.Text</option>
                    }
                </select>
            </div>

            <div class="col-md-1">
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i> Buscar
            </button>
            </div>

        </div>

        
    </form>

    <!-- Tabla -->
    <div class="table-responsive">
        <table class="table table-hover align-middle shadow-sm">
            <thead class="bg-azul">
                <tr>
                    <th>Departamentos y Municipios</th>
                    <th>Fecha Salida</th>
                    <th>Fecha Regreso</th>
                    <th>Destinos</th>
                    <th>Km's</th>
                    <th>Km/Gal</th>
                    <th>Galones Estim.</th>
                    <th>Precio Combus.</th>
                    <th>Ppto. Estimado</th>
                    <th>Ppto. Aprobado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ComisionesList!)
                {
                    <tr>
                        <td>
                            @foreach(var dep in item.DepartamentosYMunicipios)
                            {
                                @dep <br />
                            }
                        </td>
                        <td>@item.Fecha_Salida.ToString("dd/MM/yyyy")</td>
                        <td>@item.Fecha_Regreso.ToString("dd/MM/yyyy")</td>
                        <td class="text-nowrap">
                            @foreach (var dest in item.Destinos)
                            {
                                <div>@dest</div>
                            }
                        </td>
                        <td>@item.Kilometros</td>
                        <td>@item.ComsumoKmPorGalon</td>
                        <td>@item.GalonesEstimados</td>
                        <td>@item.Precio_Gasolina</td>
                        <td>@item.Prespuesto_Estimado</td>
                        @if(item.PresupuestoAprobado.HasValue)
                        {
                            <td> @item.PresupuestoAprobado.Value</td>
                        }
                        else
                        {
                            <td>Sin Aprobar</td>
                        }
                        <td class="text-center">
                            <!-- Botón que abre el modal -->
                            <button type="button" class="btn btn-sm btn-outline-primary" 
                                    data-bs-toggle="modal" 
                                    data-bs-target="#precioModal"
                                    data-id="@item.ComisionId"
                                    data-presupuesto="@item.Prespuesto_Estimado">
                                <i class="bi bi-check-circle"></i> Seleccionar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!-- Paginación -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/Comision/List?currentPage=@(Model.CurrentPage != 1 ? Model.CurrentPage-1 : Model.CurrentPage)">Atrás</a>
            </li>
            @for(int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" href="/Comision/List?currentPage=@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages || Model.TotalPages == 0 ? "disabled" : "")">
                <a class="page-link" href="/Comision/List?currentPage=@(Model.CurrentPage != Model.TotalPages ? Model.CurrentPage+1 : Model.CurrentPage)">Siguiente</a>
            </li>
        </ul>
    </nav>

    <div class="mt-3">
        <a href="/Home/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Atrás
        </a>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="precioModal" tabindex="-1" aria-labelledby="precioModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="precioModalLabel">Enviar Precio</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="AprobarCombustible" method="post">
                        <input type="hidden" id="ComisionId" name="ComisionId" />

                        <div class="mb-3">
                            <label for="presupuestoInput" class="form-label">Presupuesto Estimado</label>
                            <input type="text" class="form-control" id="presupuestoInput" readonly />
                        </div>

                        <div class="mb-3">
                            <label for="PrespuestoAprobado" class="form-label">Presupuesto Aprobado (Montos fijos divisibles en 50)</label>
                            <input type="number" class="form-control" id="PrespuestoAprobado" name="PrespuestoAprobado" required />
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-send"></i> Enviar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Captura ID y Presupuesto al abrir el modal
        var precioModal = document.getElementById('precioModal');
        precioModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var comisionId = button.getAttribute('data-id');
            var presupuesto = button.getAttribute('data-presupuesto');

            document.getElementById('ComisionId').value = comisionId;
            document.getElementById('presupuestoInput').value = presupuesto;
        });
    </script>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
