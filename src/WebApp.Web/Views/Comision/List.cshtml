@using WebApp.Domain.Comisiones
@model WebApp.Web.Models.Comisiones.ComisionListViewModel;

@{
    ViewData["Title"] = "Listado de Comisiones";

    var routeData = new Dictionary<string, string>();

    if (Model.Fecha_Inicio.HasValue) 
        routeData["fecha_inicio"] = Model.Fecha_Inicio.Value.ToString("yyyy-MM-dd");
        
    if (Model.Fecha_Fin.HasValue) 
        routeData["fecha_fin"] = Model.Fecha_Fin.Value.ToString("yyyy-MM-dd");
        
    if (Model.Estado.HasValue) 
        routeData["estado"] = Model.Estado.Value.ToString();

    if(Model.Departamentos is not null)
    for (int i = 0; i < Model.Departamentos.Count; i++)
    {
        routeData[$"departamentos[{i}]"] = Model.Departamentos[i].ToString();
    }
    
    if(Model.Municipios is not null)
    for (int i = 0; i < Model.Municipios.Count; i++)
    {
        routeData[$"municipios[{i}]"] = Model.Municipios[i].ToString();
    }
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Administración de Comisiones</h2>
        <a href="/Comision/Crear" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nueva Comisión
        </a>
    </div>

    <!-- Barra de búsqueda -->
    <form action="/Comision/List" method="get" class="mb-4">
        <div class="row g-3 align-items-end">
            <!-- Buscar por departamento -->
            <div class="col-md-3">
                <label for="departamento" class="form-label fw-bold">
                    <i class="bi bi-pin-map"></i> Departamentos
                </label>
                <select asp-for="Departamentos" 
                    asp-items="Model.DepartamentosList" 
                    id="DepartamentoId" 
                    multiple="multiple" 
                    class="form-select select2">
                </select>
            </div>
            <!-- Buscar por municipio -->
            <div class="col-md-3">
                <label for="municipios" class="form-label fw-bold">
                    <i class="bi bi-pin-map"></i> Municipios
                </label>
                <select asp-for="Municipios" 
                    id="MunicipioId" 
                    multiple="multiple" 
                    class="form-select select2">
                </select>
            </div>

            <!-- Fecha de inicio -->
            <div class="col-md-2">
                <label for="fecha_inicio" class="form-label fw-bold">
                    <i class="bi bi-calendar-event"></i> Fecha Inicio
                </label>
                <input asp-for="Fecha_Inicio" 
                    type="date" 
                    class="form-control shadow-sm" 
                    id="fecha_inicio" 
                    name="fecha_inicio">
            </div>

            <!-- Fecha de fin -->
            <div class="col-md-2">
                <label for="fecha_fin" class="form-label fw-bold">
                    <i class="bi bi-calendar-check"></i> Fecha Fin
                </label>
                <input asp-for="Fecha_Fin" 
                    type="date" 
                    class="form-control shadow-sm" 
                    id="fecha_fin" 
                    name="fecha_fin">
            </div>
            <!-- Estado -->
            <div class="col-md-1">
                <label for="estado" class="form-label fw-bold">
                    <i class="bi bi-tag"></i> Estado
                </label>
                <select asp-for="Estado"  name="Estado" id="estado" class="form-control">
                    <option value="">Seleccionar estado</option>
                    @foreach (SelectListItem estado in Model.EstadosList)
                    {
                        <option value="@estado.Value">@estado.Text</option>
                    }
                </select>
            </div>

            <div class="col-md-1">
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i> Buscar
            </button>
            </div>

        </div>

        
    </form>

    <!-- Tabla de comisiones -->
    <div class="table-responsive">
        <table class="table table-hover align-middle shadow-sm">
            <thead class="bg-azul">
                <tr>
                    <th><a class="text-white text-decoration-none" href="/Comision/List?orderBy=departamento">Departamento</a></th>
                    <th><a class="text-white text-decoration-none" href="/Comision/List?orderBy=fecha_salida">Fecha Salida</a></th>
                    <th><a class="text-white text-decoration-none" href="/Comision/List?orderBy=fecha_entrada">Fecha Entrada</a></th>
                    <th>Vehículo</th>
                    <th>Estado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.ComisionesList)
                {
                    <tr>
                        <td>@foreach(var dep in item.DepartamentosYMunicipios)
                            {
                                @dep <br />
                            }
                        </td>
                        <td>@item.Fecha_Salida.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Fecha_Regreso.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Descripcion_Vehiculo</td>
                        <td>@item.Estado</td>
                        <td class="text-center">
                            @if(item.Estado != ComisionEstados.Cancelada.ToString() && item.Estado != ComisionEstados.Completada.ToString())
                            {
                                <a href="/Comision/Edit?id=@item.ComisionId" 
                                class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <form asp-action="Cancelar" asp-controller="Comision" method="post" 
                                    onsubmit="return confirmarCancelacion();" style="display:inline;">
                                    <input type="hidden" name="ComisionId" value="@item.ComisionId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-x-circle"></i> Cancelar
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a href="/Comision/Detalle?id=@item.ComisionId" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i> Ver
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    @if (Model.TotalPages > 0)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                
                <!-- Botón Atrás -->
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    @{
                        var prevRoute = new Dictionary<string, string>(routeData) { ["currentPage"] = (Model.CurrentPage - 1).ToString() };
                    }
                    <a class="page-link" asp-controller="Comision" asp-action="List" asp-all-route-data="prevRoute">Atrás</a>
                </li>

                <!-- Páginas Numeradas -->
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    var pageRoute = new Dictionary<string, string>(routeData) { ["currentPage"] = i.ToString() };
                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                        <a class="page-link" asp-controller="Comision" asp-action="List" asp-all-route-data="pageRoute">@i</a>
                    </li>
                }

                <!-- Botón Siguiente -->
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    @{
                        var nextRoute = new Dictionary<string, string>(routeData) { ["currentPage"] = (Model.CurrentPage + 1).ToString() };
                    }
                    <a class="page-link" asp-controller="Comision" asp-action="List" asp-all-route-data="nextRoute">Siguiente</a>
                </li>

            </ul>
        </nav>
    }
    <div class="mt-3">
        <a href="/Home/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Atrás
        </a>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            // Inicialización de componentes Select2
            $('.select2').select2({ placeholder: "Seleccione opciones...", allowClear: true, width: '100%' });
            $('.select2-single').select2({ placeholder: "Seleccione una opción", allowClear: true, width: '100%' });

            // Carga dinámica de Municipios
            $('#DepartamentoId').on('change', async function () {
                const deptoIds = $(this).val();
                const $municipioSelect =$('#MunicipioId');
                $municipioSelect.empty().trigger('change');

                if (!deptoIds || deptoIds.length === 0) return;

                try {
                    const queryParams = deptoIds.map(id => `departamentosIds=${id}`).join('&');
                    const response = await fetch(`/Municipio/GetMunicipiosByDepartamentosIds?${queryParams}`);
                    if (response.ok) {
                        const data = await response.json();
                        const municipios = Array.isArray(data) ? data : (data.value || data.data || []);
                        municipios.forEach(m => $municipioSelect.append(new Option(m.nombre, m.id, false, false)));$municipioSelect.trigger('change');
                    }
                } catch (err) {
                    console.error("Error al cargar municipios:", err);
                }
            }); 
        });
    </script>
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
