@using WebApp.Application.Comisiones.Queries.GetComisionesDetalle
@using WebApp.Domain.Comisiones
@model WebApp.Application.Core.PagedList<GetComisionesDetalleResponse>;

@{
    ViewData["Title"] = "Listado de Comisiones";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Administración de Comisiones</h2>
        <a href="/Comision/Crear" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nueva Comisión
        </a>
    </div>

    <!-- Barra de búsqueda -->
    <form action="/Comision/List" method="get" class="mb-4">
        <div class="row g-3 align-items-end">
            <!-- Buscar por departamento -->
            <div class="col-md-3">
                <label for="departamento" class="form-label fw-bold">
                    <i class="bi bi-pin-map"></i> Departamento
                </label>
                <input type="text" 
                    class="form-control shadow-sm" 
                    id="departamento" 
                    name="departamento" 
                    placeholder="Ej. Quetzaltenango">
            </div>

            <!-- Fecha de inicio -->
            <div class="col-md-3">
                <label for="fecha_inicio" class="form-label fw-bold">
                    <i class="bi bi-calendar-event"></i> Fecha Inicio
                </label>
                <input type="date" 
                    class="form-control shadow-sm" 
                    id="fecha_inicio" 
                    name="fecha_inicio">
            </div>

            <!-- Fecha de fin -->
            <div class="col-md-3">
                <label for="fecha_fin" class="form-label fw-bold">
                    <i class="bi bi-calendar-check"></i> Fecha Fin
                </label>
                <input type="date" 
                    class="form-control shadow-sm" 
                    id="fecha_fin" 
                    name="fecha_fin">
            </div>
            <!-- Estado -->
            <div class="col-md-2">
                <label for="estado" class="form-label fw-bold">
                    <i class="bi bi-tag"></i> Estado
                </label>
                <select name="Estado" id="estado" class="form-control">
                    <option value="">Seleccionar estado</option>
                    @foreach (var estado in ViewBag.Estados)
                    {
                        <option value="@estado">@estado</option>
                    }
                </select>
            </div>

            <div class="col-md-1">
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-search"></i> Buscar
            </button>
            </div>

        </div>

        
    </form>

    <!-- Tabla de comisiones -->
    <div class="table-responsive">
        <table class="table table-hover align-middle shadow-sm">
            <thead class="bg-azul">
                <tr>
                    <th><a class="text-white text-decoration-none" href="/Comision/List?orderBy=departamento">Departamento</a></th>
                    <th><a class="text-white text-decoration-none" href="/Comision/List?orderBy=fecha_salida">Fecha Salida</a></th>
                    <th><a class="text-white text-decoration-none" href="/Comision/List?orderBy=fecha_entrada">Fecha Entrada</a></th>
                    <th>Vehículo</th>
                    <th>Estado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.Items)
                {
                    <tr>
                        <td>@item.Departamento</td>
                        <td>@item.Fecha_Salida.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Fecha_Regreso.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Descripcion_Vehiculo</td>
                        <td>@item.Estado</td>
                        <td class="text-center">
                            @if(item.Estado != ComisionEstados.Cancelada.ToString() && item.Estado != ComisionEstados.Completada.ToString())
                            {
                                <a href="/Comision/Edit?id=@item.ComisionId" 
                                class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <form asp-action="Cancelar" asp-controller="Comision" method="post" 
                                    onsubmit="return confirmarCancelacion();" style="display:inline;">
                                    <input type="hidden" name="ComisionId" value="@item.ComisionId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-x-circle"></i> Cancelar
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a href="/Comision/Detalle?id=@item.ComisionId" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i> Ver
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/Comision/List?currentPage=@(Model.CurrentPage != 1 ? Model.CurrentPage-1 : Model.CurrentPage)">Atrás</a>
            </li>
            @for(int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" href="/Comision/List?currentPage=@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages || Model.TotalPages == 0 ? "disabled" : "")">
                <a class="page-link" href="/Comision/List?currentPage=@(Model.CurrentPage != Model.TotalPages ? Model.CurrentPage+1 : Model.CurrentPage)">Siguiente</a>
            </li>
        </ul>
    </nav>

    <div class="mt-3">
        <a href="/Home/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Atrás
        </a>
    </div>
</div>

<script>
function confirmarCancelacion() {
    return confirm("¿Estás seguro de que deseas cancelar esta comisión?");
}
</script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
