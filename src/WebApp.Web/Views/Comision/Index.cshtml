@model List<WebApp.Application.Comisiones.Queries.GetComisionesActivas.GetComisionesActivasResponse>

@{
    ViewBag.Title = "Comisiones Activas";
}

<h2>Comisiones Activas</h2>

<table class="table table-bordered table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nombramiento</th>
            <th>Departamento</th>
            <th>Fecha Salida</th>
            <th>Fecha Regreso</th>
            <th>Estado</th>
            <th>Piloto</th>
            <th style="width:120px;">Acción</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombramiento</td>
                    <td>@item.Departamento</td>
                    <td>@item.Fecha_Salida.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Fecha_Regreso.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <span class="badge bg-success">
                            @item.Estado
                        </span>
                    </td>
                    <td>
                        @(item.Piloto ? "Sí" : "No")
                    </td>
                    <td>
                        <a asp-controller="Comisiones"
                           asp-action="Detalle"
                           asp-route-id="@item.id"
                           class="btn btn-primary btn-sm">
                            Ver
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">
                    No hay comisiones activas registradas.
                </td>
            </tr>
        }
    </tbody>
</table>