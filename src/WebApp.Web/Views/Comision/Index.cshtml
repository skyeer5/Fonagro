@using WebApp.Domain.Comisiones
@model WebApp.Web.Models.Comisiones.ComisionViewModel

@{
    ViewBag.Title = "Mi Comisión";
    var gasolinas = ViewBag.Gasolinas as IEnumerable<WebApp.Application.Gasolinas.Queries.GetGasolinasWithFecha.GetGasolinasWithFechaResponse>;
}

<h2 class="mb-4">Mi Comisión</h2>

<div class="row">

    <!-- ================= MAIN ================= -->
    <div class="col-md-9">

    @* ================= SIN COMISIÓN ================= *@
    @if (!Model.TieneComisionCreada)
    {
        <div class="card border-azul shadow-sm">
            <div class="card-header bg-azul">
                ¿Cómo realizar una comisión?
            </div>

            <div class="card-body">

                <p class="mb-3">
                    Sigue este flujo para gestionar una comisión dentro del sistema:
                </p>

                <ol class="mb-4">
                    <li><strong>Nombramientos:</strong> El coordinador asigna participantes.</li>
                    <li><strong>Coordinación:</strong> Se define logística con Servicios Generales.</li>
                    <li><strong>Destinos:</strong> El resp. del vehículo registra los destinos.</li>
                    <li><strong>Aprobación:</strong> Se autoriza el combustible.</li>
                    <li><strong>Ejecución:</strong> La comisión se realiza.</li>
                </ol>

                <div class="alert alert-secondary mb-0">
                    Cuando tengas un nombramiento asignado, podrás gestionarlo aquí.
                </div>

            </div>
        </div>
    }
    else
    {
        @* ================= ESTADO ================= *@
            <div class="card border-primary mb-4 shadow-sm">
                <div class="card-header bg-primary text-white">
                    Estado de la Comisión
                </div>

                <div class="card-body">

                    <!-- Flujo -->
                    <div class="d-flex justify-content-between text-center mb-3">

                        <div class="flex-fill">
                            <small class="text-muted">1</small><br />
                            Nombramientos
                        </div>

                        <div class="flex-fill @(Model.Comision!.Estado == ComisionEstados.Creada ? "text-primary fw-bold" : "")">
                            <small>2</small><br />
                            Coordinación
                        </div>

                        <div class="flex-fill @(Model.Comision.Estado == ComisionEstados.DestinosDefinidos ? "text-primary fw-bold" : "")">
                            <small>3</small><br />
                            Destinos
                        </div>

                        <div class="flex-fill @(Model.Comision.Estado == ComisionEstados.Programada ? "text-primary fw-bold" : "")">
                            <small>4</small><br />
                            Aprobación
                        </div>

                        <div class="flex-fill @(Model.Comision.Estado == ComisionEstados.EnCurso ? "text-success fw-bold" : "")">
                            <small>5</small><br />
                            Ejecución
                        </div>

                    </div>

                    <!-- Mensaje -->
                    <div class="alert alert-light mb-0">

                        @switch (Model.Comision.Estado)
                        {
                            case ComisionEstados.Creada:
                                <span>Se ha asignado resp. del vehiculo. Pendiente registro de destinos.</span>
                                break;

                            case ComisionEstados.DestinosDefinidos:
                                <span>Destinos registrados. Pendiente aprobación de combustible.</span>
                                break;

                            case ComisionEstados.Programada:
                                <span>Comisión aprobada y lista para ejecutarse.</span>
                                break;

                            case ComisionEstados.EnCurso:
                                <span>La comisión se encuentra en ejecución.</span>
                                break;

                            default:
                                <span>Estado actual de la comisión.</span>
                                break;
                        }

                    </div>

                </div>
            </div>

            @* ================= INFO ================= *@
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-dark text-white">
                    Información de la Comisión
                </div>

                <div class="card-body">

                    <div class="row mb-2">
                        <div class="col-md-6"><strong>Nombramiento:</strong> @Model.Comision.Nombramiento</div>
                        <div class="col-md-6"><strong>Estado: </strong><span class="badge bg-primary">@Model.Comision.Estado</span></div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-6"><strong>Salida:</strong> @Model.Comision.Fecha_Salida.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="col-md-6"><strong>Regreso:</strong> @Model.Comision.Fecha_Regreso.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-6"><strong>Departamento:</strong> @Model.Comision.Departamento</div>
                        <div class="col-md-6"><strong>Municipio:</strong> @Model.Comision.Municipio</div>
                    </div>

                    <form asp-controller="Comision" asp-action="AgregarDescripcion" method="post">
                        <input type="hidden" name="IdComision" value="@Model.Comision.ComisionId" />

                        <label class="form-label"><strong>Descripción</strong></label>
                        <textarea name="Descripcion" class="form-control mb-2">@Model.Comision.Descripcion</textarea>

                        <button type="submit" class="btn btn-primary btn-sm">
                            Guardar
                        </button>
                    </form>

                </div>
            </div>

            @* ================= DESTINOS ================= *@
            @if (Model.TieneCombustiblesAprobados)
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-dark text-white">
                        Destinos
                    </div>

                    <div class="card-body table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Descripción</th>
                                    <th>Kilómetros</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in Model.Comision.Destinos!)
                                {
                                    <tr>
                                        <td>@d.descripcion</td>
                                        <td><span class="badge bg-primary">@d.kilometros km</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="mb-4">
                    <button type="button" class="btn btn-sm btn-success btn-imprimir"
                            data-id="@Model.Comision.ComisionId">
                             Plan de Viaje
                    </button>

                    <a asp-action="ImprimirViaticos" asp-route-id="@Model.Comision.ComisionId"
                       class="btn btn-success">
                        Viáticos
                    </a>
                </div>
            }
        <!-- FORMULARIO DESTINOS (INLINE OPCIONAL) -->
        @if (Model.EsPiloto && !Model.TieneCombustiblesAprobados)
        {
            <div class="card">
                <div class="card-header">
                    Agregar Destinos *Eres el responsable del vehículo asignado, registra los destinos de tu comisión para avanzar al siguiente paso.
                </div>

                <div class="card-body">
                    <form asp-controller="Comision" asp-action="AgregarDestinos" method="post">

                        <input type="hidden" name="ComisionId" value="@Model.Comision!.ComisionId" />

                        <div id="destinos-container">
                            @if(Model.Comision.Destinos is null || Model.Comision.Destinos.Count == 0)
                            {
                                <div class="row mb-2 destino-row">
                                    <div class="col-md-5">
                                        <input name="comisionAddDestinosItemRequests[0].Descripcion" class="form-control" placeholder="Descripción" value="Recorrido Interno" />
                                    </div>
                                    <div class="col-md-5">
                                        <input name="comisionAddDestinosItemRequests[0].Kilometro" type="number" step="0.01" class="form-control" placeholder="Kilómetros" />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-outline-danger btn-remove-destino w-100">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                int i = 0;
                                foreach(var d in Model.Comision.Destinos)
                                {
                                    <div class="row mb-2 destino-row">
                                        <input type="hidden" name="ComisionAddDestinosItemRequests[@i].ComisionDestinoId" value="@d.id" />
                                        <div class="col-md-5">
                                            <input name="ComisionAddDestinosItemRequests[@i].Descripcion" class="form-control" placeholder="Descripción" value="@d.descripcion" />
                                        </div>
                                        <div class="col-md-5">
                                            <input name="ComisionAddDestinosItemRequests[@i].Kilometro" type="number" step="0.01" class="form-control" value="@d.kilometros" placeholder="Kilómetros" />
                                        </div>
                                        <div class="col-md-2">
                                            <button type="button" class="btn btn-outline-danger btn-remove-destino w-100">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </button>
                                        </div>
                                    </div> 
                                    i++; 
                                }
                            }
                        </div>

                        <button type="button" id="btnAddDestino" class="btn btn-secondary mb-3">
                            + Agregar otro destino
                        </button>

                        <br />

                        <button type="submit" class="btn btn-primary">
                            Guardar Destinos
                        </button>

                    </form>
                </div>
            </div>
        }
    }
    
    </div>

    <!-- ================= SIDEBAR ================= -->
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-header">
                Precio de Gasolina
            </div>

            <div class="card-body p-2">
                <ul class="list-group list-group-flush">
                    @foreach (var g in gasolinas!)
                    {
                        <li class="list-group-item small">
                            @g.Descripcion
                        </li>
                    }
                </ul>
            </div>
        </div>
        @if (Model.TieneComisionCreada)
        {
        <div class="card border-negro shadow-sm mt-4">
                <div class="card-header bg-negro text-white">
                    ¿Cómo realizar una comisión?
                </div>

                <div class="card-body">

                    <p class="mb-3">
                        Sigue este flujo para gestionar una comisión dentro del sistema:
                    </p>

                    <ol class="mb-4">
                        <li><strong>Nombramientos:</strong> El coordinador asigna participantes.</li>
                        <li><strong>Coordinación:</strong> Se define logística con Servicios Generales.</li>
                        <li><strong>Destinos:</strong> El responsable del vehículo registra los destinos.</li>
                        <li><strong>Aprobación:</strong> Se autoriza el combustible.</li>
                        <li><strong>Ejecución:</strong> La comisión se realiza.</li>
                    </ol>
                </div>
            </div>
            }
    </div>

    <!-- Modal de generación de PDF -->
    <div class="modal fade" id="modalGenerandoPdf" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">
                <div class="modal-body">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Generando...</span>
                    </div>
                    <h5 class="fw-bold">Generando el PDF</h5>
                    <p class="text-muted mb-0">Esto puede tardar unos segundos, por favor espera...</p>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts{
<script>
let index = 1;

document.addEventListener("DOMContentLoaded", function () {
    const container = document.getElementById("destinos-container");
    const btnAdd = document.getElementById("btnAddDestino");

    // Función para reindexar todos los inputs cuando se elimine o agregue una fila
    function reindexarDestinos() {
        const rows = container.querySelectorAll(".destino-row");
        rows.forEach((row, index) => {
            const inputDesc = row.querySelector("input[name*='.Descripcion']");
            const inputKms = row.querySelector("input[name*='.Kilometro']");
            const inputid = row.querySelector("input[name*='.ComisionDestinoId']");

            if (inputDesc) inputDesc.name = `ComisionAddDestinosItemRequests[${index}].Descripcion`;
            if (inputKms) inputKms.name = `ComisionAddDestinosItemRequests[${index}].Kilometro`;
            if (inputid) inputid.name = `ComisionAddDestinosItemRequests[${index}].ComisionDestinoId`;
        });
    }

    // Agregar nuevo destino
    btnAdd?.addEventListener("click", function () {
        const index = container.querySelectorAll(".destino-row").length;

        const row = document.createElement("div");
        row.className = "row mb-2 destino-row";

        row.innerHTML = `
            <div class="col-md-5">
                <input name="ComisionAddDestinosItemRequests[${index}].Descripcion" class="form-control" placeholder="Descripción" />
            </div>
            <div class="col-md-5">
                <input name="ComisionAddDestinosItemRequests[${index}].Kilometro" type="number" step="0.01" class="form-control" placeholder="Kilómetros" />
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-outline-danger btn-remove-destino w-100">
                    <i class="bi bi-trash"></i> Eliminar
                </button>
            </div>
        `;

        container.appendChild(row);
    });

    // Delegación de eventos para eliminar fila (sirve para filas iniciales y dinámicas)
    container.addEventListener("click", function (e) {
        if (e.target.closest(".btn-remove-destino")) {
            const row = e.target.closest(".destino-row");
            
            // Opcional: Evita eliminar si solo queda una fila
            if (container.querySelectorAll(".destino-row").length > 1) {
                row.remove();
                reindexarDestinos();
            } else {
                alert("Debe mantener al menos un destino registrado.");
            }
        }
    });
});

const modalGenerandoPdf = new bootstrap.Modal(document.getElementById('modalGenerandoPdf'));

        document.querySelectorAll('.btn-imprimir').forEach(btn => {
            btn.addEventListener('click', () => generarPdf(btn.dataset.id));
        });

async function generarPdf(ComisionId) {
    modalGenerandoPdf.show();

    try {
        const response = await fetch(`/Comision/ImprimirPlanViaje?idComision=${ComisionId}`);

        if (!response.ok) {
            throw new Error(`Error del servidor: ${response.status}`);
        }

        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);

        const link = document.createElement('a');
        link.href = url;
        link.download = `planDeViaje-${ComisionId}.pdf`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        window.URL.revokeObjectURL(url);

        } catch (error) {
            alert('No se pudo generar el PDF. Intenta de nuevo. ' + error.message);
        } finally {
            modalGenerandoPdf.hide();
        }
    }
</script>
}