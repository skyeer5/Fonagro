@model WebApp.Web.Models.Comisiones.ComisionCreateViewModel
@{
    ViewData["Title"] = "Crear Comisión";
}

<h2>Crear Comisión</h2>

<form id="formCrearComision" asp-action="Crear" method="post">

    <div class="row row-cols-1 row-cols-md-2 g-3">

        <div class="col">
            <label>Departamento de visita</label>
            <input id="departamentoVisita" class="form-control" type="text" disabled readonly>
        </div>

        <div class="col">
            <label>Municipio de visita</label>
            <input id="municipioVisita" class="form-control" type="text" disabled readonly>
        </div>

        <div class="col">
            <label>Fecha salida</label>
            <input id="fechaSalida" class="form-control" type="text" disabled readonly>
        </div>

        <div class="col">
            <label>Fecha regreso</label>
            <input id="fechaRegreso" class="form-control" type="text" disabled readonly>
        </div>
        
        <div class="col">
            <label>Vehículo</label>
            <select asp-for="VehiculoId" asp-items="Model.Vehiculos" class="form-select" id="vehiculoSelect">
                <option value="">-- Seleccione --</option>
            </select>
        </div>
    </div>
    <hr />

    <h4>Usuarios nombrados</h4>

    <table id="tablaUsuarios" class="table">
        <thead>
            <tr>
                <th>Descripción del nombramiento</th>
                <th>Responsable</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <select name="Nombramientos[0]" class="form-select nombramiento-select" required>
                        <option value="">-- Seleccione --</option>
                        @foreach (SelectListItem u in Model.NombramientosList!)
                        {
                            <option value="@u.Value">@u.Text</option>
                        }
                    </select>
                </td>
                <td>Responsable del vehículo</td>
                <td class="text-center">
                    <button type="button" class="btn btn-danger btn-sm" disabled>X</button>
                </td>
            </tr>
        </tbody>
    </table>

    <button type="button" class="btn btn-success" onclick="agregarUsuario()">
        Agregar Nombramiento
    </button>

    @if (TempData["msg"] != null)
    {
        <div class="alert mt-3 alert-danger">
            @TempData["msg"]
        </div>
    }
    <div class="mt-3">
        <button type="submit" class="btn btn-primary mt-3">
        Guardar comisión
        </button>
    </div>

</form>


<div class="modal fade" id="confirmarComisionModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar comisión</h5>
            </div>
            <div class="modal-body">
                <p id="mensajeConfirmacion"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarComision" class="btn btn-primary">Confirmar</button>
            </div>
        </div>
    </div>
</div>


<script type="text/template" id="usuarioTemplate">
<tr>
    <td>
        <select name="Nombramientos[__i__]" class="form-select nombramiento-select" required>
            <option value="">-- Seleccione --</option>
            @foreach (SelectListItem u in Model.NombramientosList!)
            {
                <option value="@u.Value">@u.Text</option>
            }
        </select>
    </td>
    <td></td>
    <td class="text-center">
        <button type="button" class="btn btn-danger btn-sm" onclick="eliminarFila(this)">X</button>
    </td>
</tr>
</script>


@section Scripts {
    <script>
        let index = 1;

        function agregarUsuario() {
            const template = document.getElementById("usuarioTemplate").innerHTML;
            const fila = template.replaceAll("__i__", index++);
            document.querySelector("#tablaUsuarios tbody").insertAdjacentHTML("beforeend", fila);
        }

        function eliminarFila(btn) {
            btn.closest("tr").remove();
        }

        const departamentoVisita = document.getElementById("departamentoVisita");
        const municipioVisita = document.getElementById("municipioVisita");
        const fechaSalida = document.getElementById("fechaSalida");
        const fechaRegreso = document.getElementById("fechaRegreso");

        document.addEventListener("change", async function (event) {
            if (!event.target.classList.contains("nombramiento-select")) return;

            const primerNombramiento = document.querySelector('select[name="Nombramientos[0]"]');
            if (!primerNombramiento || event.target !== primerNombramiento) return;

            const nombramientoId = primerNombramiento.value;

            if (!nombramientoId) {
                departamentoVisita.value = "";
                municipioVisita.value = "";
                fechaSalida.value = "";
                fechaRegreso.value = "";
                return;
            }

            try {
                const response = await fetch(`/Nombramiento/ObtenerDatosById?nombramientoId=${encodeURIComponent(nombramientoId)}`);
                if (!response.ok) throw new Error("No fue posible obtener los datos del nombramiento.");

                const data = await response.json();
                departamentoVisita.value = data.departamentos ?? "";
                municipioVisita.value = data.municipios ?? "";
                fechaSalida.value = formatearFecha(data.fecha_Salida);
                fechaRegreso.value = formatearFecha(data.fecha_Regreso);
            } catch (error) {
                departamentoVisita.value = "";
                municipioVisita.value = "";
                fechaSalida.value = "";
                fechaRegreso.value = "";
                console.error(error);
                alert("No fue posible obtener los datos del nombramiento.");
            }
        });

        function formatearFecha(fecha) {
            if (!fecha) return "";
            const date = new Date(fecha);
            return date.toLocaleString("es-GT", {
                day: "2-digit",
                month: "2-digit",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit"
            });
        }

        // =====================================================
        // MODAL DE CONFIRMACIÓN
        // =====================================================
        const formularioComision = document.getElementById("formCrearComision");
        const modalElement = document.getElementById("confirmarComisionModal");
        const mensajeConfirmacion = document.getElementById("mensajeConfirmacion");
        const btnConfirmarComision = document.getElementById("btnConfirmarComision");

        let formularioConfirmado = false;

        formularioComision.addEventListener("submit", function (event) {
            if (formularioConfirmado) {
                return;
            }

            // Si faltan campos requeridos por llenar, deja actuar a la validación de HTML5
            if (!formularioComision.checkValidity()) {
                return;
            }

            event.preventDefault();

            const vehiculoId = vehiculoSelect.value;

            if (vehiculoId) {
                const vehiculoSeleccionado = vehiculoSelect.options[vehiculoSelect.selectedIndex].text;
                mensajeConfirmacion.textContent = `La comisión se realizará utilizando el vehículo "${vehiculoSeleccionado}". ¿Desea continuar?`;
            } else {
                mensajeConfirmacion.textContent = "La comisión se realizará sin vehículo. ¿Desea continuar?";
            }

            // Aquí ya no dará error porque Bootstrap ya está cargado
            const modalConfirmacion = bootstrap.Modal.getOrCreateInstance(modalElement);
            modalConfirmacion.show();
        });

        btnConfirmarComision.addEventListener("click", function () {
            formularioConfirmado = true;
            formularioComision.requestSubmit();
        });
    </script>
}