@model WebApp.Application.Comisiones.ComisionCreate.ComisionCreateRequest;

@{
    ViewData["Title"] = "Crear Comisión";
}

<h2>Crear Comisión</h2>

<form asp-action="Crear" method="post">

    <!-- ================= DATOS GENERALES ================= -->
    <div class="row row-cols-1 row-cols-md-2 g-3">
        <div class="col">
            <label>Departamento de visita</label>
            <select asp-for="Departamento" 
                asp-items="ViewBag.Departamentos" 
                multiple="multiple" 
                class="select2">
            </select>

        </div>

        <div class="col">
            <label>Vehículo</label>
            <select asp-for="VehiculoId" asp-items="ViewBag.Vehiculos" 
                    class="form-select" id="vehiculoSelect" required>
                <option value="">-- Seleccione --</option>
            </select>
        </div>
        
        <div class="col">
            <label>Fecha salida</label>
            <input asp-for="Fecha_Salida" type="datetime-local" class="form-control" required />
        </div>

        <div class="col">
            <label>Fecha regreso</label>
            <input asp-for="Fecha_Regreso" type="datetime-local" class="form-control" required />
        </div>

    </div>
    <!-- Panel de vista previa -->
    <div id="vehiculoPreview" class="alert alert-info mt-3" style="display:none;">
        <strong>Vehículo seleccionado:</strong>
        <p id="vehiculoInfo"></p>
    </div>
    <!-- ================= USUARIOS NOMBRADOS ================= -->
        <hr />
    <h4>Usuarios nombrados</h4>

    <table class="table" id="tablaUsuarios">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>No. Nombramiento</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr class="table-success">
                <td>
                    <select name="UsuariosNombrados[0].UsuariosId"
                            class="form-select"
                            required>
                        
                        @if(ViewBag.Usuarios != null)
                        {
                            <option value="">-- Seleccione --</option>
                            @foreach (var u in (SelectList)ViewBag.Usuarios)
                            {
                                <option value="@u.Value">@u.Text</option>
                            }
                        }
                        else
                        {
                            <option value="">No hay usuarios disponibles</option>
                        }
                    </select>
                </td>

                <td>
                    <input name="UsuariosNombrados[0].Numero_Nombramiento"
                        class="form-control" required />
                </td>
                <td class="text-center">
                    Responsable del vehículo
                    <input type="hidden"
                        name="UsuariosNombrados[0].Es_Piloto"
                        value="true" />
                </td>
            </tr>
        </tbody>
    </table>

    <button type="button" class="btn btn-secondary" onclick="agregarUsuario()">
        + Agregar usuario
    </button>

    @if(TempData["msg"]!=null)
    {
        <div class="alert mt-3 alert-danger">
            @TempData["msg"]
        </div>
    }
    <button type="submit" class="btn btn-primary">
        Guardar comisión
    </button>

</form>

<!-- ================= TEMPLATE OCULTO ================= -->

<script type="text/template" id="usuarioTemplate">
<tr>
    <td>
        <select name="UsuariosNombrados[__i__].UsuariosId"
                class="form-select"
                required>
            @if(ViewBag.Usuarios != null)
                    {
                <option value="">-- Seleccione --</option>
                @foreach (var u in (SelectList)ViewBag.Usuarios)
                {
                    <option value="@u.Value">@u.Text</option>
                }
            }
            else
            {
                <option value="">No hay usuarios disponibles</option>
            }
        </select>
    </td>

    <td>
        <input name="UsuariosNombrados[__i__].Numero_Nombramiento"
               class="form-control" 
               required/>
    </td> 

    <td class="text-center">
        <button type="button"
                class="btn btn-danger btn-sm"
                onclick="eliminarFila(this)">
            X
        </button>
    </td>
</tr>
</script>


<!-- ================= JAVASCRIPT ================= -->

<script>
let index = 1;

function agregarUsuario() {
    const template = document.getElementById("usuarioTemplate").innerHTML;
    const fila = template.replaceAll("__i__", index++);
    document.querySelector("#tablaUsuarios tbody")
        .insertAdjacentHTML("beforeend", fila);
}

function eliminarFila(btn) {
    btn.closest("tr").remove();
}

document.getElementById("vehiculoSelect").addEventListener("change", function() {
    const selectedOption = this.options[this.selectedIndex];
    if (selectedOption.value) {
        // Aquí puedes personalizar qué mostrar (ejemplo: texto completo del option)
        document.getElementById("vehiculoInfo").innerText = selectedOption.text;
        document.getElementById("vehiculoPreview").style.display = "block";
    } else {
        document.getElementById("vehiculoPreview").style.display = "none";
    }
});

$(document).ready(function() {
    $('.select2').select2({
        placeholder: "Seleccione departamentos",
        allowClear: true,
        width: '100%' 
    });
});

</script>
