@model WebApp.Application.Comisiones.Command.ComisionApprovalGas.ComisionApprovalGasRequest;

@{
    ViewBag.Title = "Agregar Gasolina";
}

<h2>Agregar Gasolina</h2>

@using (Html.BeginForm("AgregarGasolina", "Comision", FormMethod.Post))
{
    <div class="form-group">
        @Html.LabelFor(m => m.ComisionId, "Comisión Id")
        @Html.TextBoxFor(m => m.ComisionId, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.PrespuestoAprobado, "Presupuesto Aprobado")
        @Html.TextBoxFor(m => m.PrespuestoAprobado, new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
}
