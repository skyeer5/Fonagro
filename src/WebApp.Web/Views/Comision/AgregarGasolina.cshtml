@model WebApp.Application.Comisiones.Command.ComisionApprovalGas.ComisionApprovalGasRequest;

@{
    ViewBag.Title = "Agregar Gasolina";
    var comisiones = ViewBag.Comisiones as IEnumerable<WebApp.Application.Comisiones.Queries.GetComisionesPendApprov.GetComisionesPendApprovResponse>;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Comisiones Pendientes</h2>
    </div>

    @if(TempData["msg"] != null)
    {
        <div class="alert alert-info mb-3 shadow-sm">
            @TempData["msg"]
        </div>
    }
    else
    {
        <!-- Tabla con diseño mejorado -->
        <div class="table-responsive">
            <table class="table table-hover align-middle shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Departamento</th>
                        <th>Fecha Salida</th>
                        <th>Fecha Regreso</th>
                        <th>Kilometros</th>
                        <th>Precio Gasolina Usado</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in comisiones!)
                    {
                        <tr>
                            <td>@item.id</td>
                            <td>@item.Departamento</td>
                            <td>@item.Fecha_Salida.ToString("dd/MM/yyyy")</td>
                            <td>@item.Fecha_Regreso.ToString("dd/MM/yyyy")</td>
                            <td>@item.Kilometros</td>
                            <td>@item.precio_Gasolina</td>
                            <td class="text-center">
                                <!-- Botón que abre el modal -->
                                <button type="button" class="btn btn-sm btn-outline-primary" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#precioModal"
                                        data-id="@item.id"
                                        data-presupuesto="@item.Prespuesto_Estimado">
                                    <i class="bi bi-check-circle"></i> Seleccionar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Modal -->
        <div class="modal fade" id="precioModal" tabindex="-1" aria-labelledby="precioModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content shadow">
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title" id="precioModalLabel">Enviar Precio</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <form asp-action="AgregarGasolina" method="post">
                            <input type="hidden" id="ComisionId" name="ComisionId" />

                            <div class="mb-3">
                                <label for="presupuestoInput" class="form-label">Presupuesto Estimado</label>
                                <input type="text" class="form-control" id="presupuestoInput" readonly />
                            </div>

                            <div class="mb-3">
                                <label for="PrespuestoAprobado" class="form-label">Presupuesto Aprobado 
                                    <!-- Botón con tooltip -->
                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Ingrese cantidad en múltiplos de 50 (ej. 100, 150, 200…) debido a que los vales de combustible solo manejan valores de 50 y 100">
                                        <i class="bi bi-info-circle"></i>
                                    </button>

                                    
                                </label>
                                <input type="number" class="form-control" id="PrespuestoAprobado" name="PrespuestoAprobado" required />
                            </div>

                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-send"></i> Enviar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    <script>
        // Captura ID y Presupuesto al abrir el modal
        var precioModal = document.getElementById('precioModal');
        precioModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var comisionId = button.getAttribute('data-id');
            var presupuesto = button.getAttribute('data-presupuesto');

            document.getElementById('ComisionId').value = comisionId;
            document.getElementById('presupuestoInput').value = presupuesto;
        });
    </script>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
