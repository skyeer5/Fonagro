@model WebApp.Web.Models.Comisiones.ComisionReportViewModel

@{
    ViewData["Title"] = "Reporte de Comisiones";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-azul text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-file-earmark-excel me-2"></i>Generar Reporte de Comisiones</h5>
        </div>
        <div class="card-body">
            <form id="formReporteComisiones">
                
                <!-- Rango de Fechas -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Fecha_Salida" class="form-label font-weight-bold">Fecha Salida (Desde)</label>
                        <input asp-for="Fecha_Salida" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Fecha_Regreso" class="form-label font-weight-bold">Fecha Regreso (Hasta)</label>
                        <input asp-for="Fecha_Regreso" type="date" class="form-control" />
                    </div>
                </div>

                <!-- Ubicación Geográfica (Listas) -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Departamentos" class="form-label font-weight-bold">Departamentos</label>
                        <select asp-for="Departamentos" asp-items="Model.DepartamentosList" id="DepartamentoId" multiple="multiple" class="form-select select2"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Municipios" class="form-label font-weight-bold">Municipios</label>
                        <select asp-for="Municipios" id="MunicipioId" multiple="multiple" class="form-select select2"></select>
                    </div>
                </div>

                <!-- Vehículo (Simple), Usuario (Simple) y Estado (Simple) -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="Vehiculo" class="form-label font-weight-bold">Vehículo</label>
                        <select asp-for="Vehiculo" asp-items="Model.VehiculosList" class="form-select select2-single">
                            <option value="">Seleccione un vehículo</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Usuario" class="form-label font-weight-bold">Personal</label>
                        <select asp-for="Usuario" asp-items="Model.UsuariosList" class="form-select select2-single">
                            <option value="">Seleccione un usuario</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Estado" class="form-label font-weight-bold">Estado de Comisión</label>
                        <select asp-for="Estado" asp-items="Model.EstadosList" class="form-select">
                            <option value="">-- Todos los estados --</option>
                        </select>
                    </div>
                </div>

                <!-- Unidades (Lista) -->
                <div class="row mb-4">
                    <div class="col-md-12">
                        <label asp-for="Unidades" class="form-label font-weight-bold">Unidades</label>
                        <select asp-for="Unidades" asp-items="Model.UnidadesList" multiple="multiple" class="form-select select2"></select>
                    </div>
                </div>

                <!-- Botones -->
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" id="btnLimpiar">
                        <i class="bi bi-eraser me-1"></i> Limpiar Filtros
                    </button>
                    <button type="submit" id="btnExportar" class="btn btn-success">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Exportar a Excel
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Inicialización de componentes Select2
            $('.select2').select2({ placeholder: "Seleccione opciones...", allowClear: true, width: '100%' });
            $('.select2-single').select2({ placeholder: "Seleccione una opción", allowClear: true, width: '100%' });

            // Carga dinámica de Municipios
            $('#DepartamentoId').on('change', async function () {
                const deptoIds = $(this).val();
                const $municipioSelect =$('#MunicipioId');
                $municipioSelect.empty().trigger('change');

                if (!deptoIds || deptoIds.length === 0) return;

                try {
                    const queryParams = deptoIds.map(id => `departamentosIds=${id}`).join('&');
                    const response = await fetch(`/Municipio/GetMunicipiosByDepartamentosIds?${queryParams}`);
                    if (response.ok) {
                        const data = await response.json();
                        const municipios = Array.isArray(data) ? data : (data.value || data.data || []);
                        municipios.forEach(m => $municipioSelect.append(new Option(m.nombre, m.id, false, false)));$municipioSelect.trigger('change');
                    }
                } catch (err) {
                    console.error("Error al cargar municipios:", err);
                }
            });

            // Limpieza del formulario
            $('#btnLimpiar').on('click', function () {
                $('#formReporteComisiones')[0].reset();
                $('.select2, .select2-single').val(null).trigger('change');
            });

            // Submit Asíncrono
            $('#formReporteComisiones').on('submit', async function (e) {
                e.preventDefault();

                const $btn =$('#btnExportar');
                const originalHtml = $btn.html();$btn.prop('disabled', true).html(`<span class="spinner-border spinner-border-sm me-2"></span>Generando...`);

                // 1. Convertir datos del formulario a un Objeto JSON limpio
                const formData = new FormData(this);
                const payload = {
                    Fecha_Salida: formData.get('Fecha_Salida') || null,
                    Fecha_Regreso: formData.get('Fecha_Regreso') || null,
                    Departamentos: formData.getAll('Departamentos').map(Number),
                    Municipios: formData.getAll('Municipios').map(Number),
                    Vehiculo: formData.get('Vehiculo') ? Number(formData.get('Vehiculo')) : null,
                    Usuario: formData.get('Usuario') ? Number(formData.get('Usuario')) : null,
                    Unidades: formData.getAll('Unidades').map(Number),
                    Estado: formData.get('Estado') ? Number(formData.get('Estado')) : null
                };

                try {
                    // 2. Enviar mediante HTTP POST
                    const response = await fetch('/Comision/ImprimirReporte', {
                        method: 'POST', // Debe coincidir con [HttpPost]
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(payload) // payload contiene los datos del formulario
                    });

                    if (!response.ok) {
                        // Lee el objeto JSON devuelto por BadRequest en C#
                        const errorData = await response.json();
                        alert(errorData.mensaje || 'Error al generar el reporte.');
                        return;
                    }

                    // Si es exitoso, procede a la descarga del Blob...
                    const blob = await response.blob();
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `ComisionReporte_${new Date().toISOString().slice(0, 10)}.xlsx`;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url);

                } catch (error) {
                    console.error("Error de descarga:", error);
                    alert("Ocurrió un error al intentar comunicar con el servidor.");
                } finally {
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        });
    </script>
}