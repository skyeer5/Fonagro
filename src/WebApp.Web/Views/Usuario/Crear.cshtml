@model WebApp.Application.Usuarios.Commands.UsuarioCreate.UsuarioCreateRequest;

@{
    ViewData["Title"] = "Crear Usuario";
}

<h2 class="text-xl font-semibold mb-4">Crear Usuario</h2>

<form asp-action="Crear" method="post" class="max-w-xl">
    <div class="row row-cols-1 row-cols-md-2 g-3">
        <div class="col">
            <label asp-for="Nombre_Completo" class="form-label">Nombre completo</label>
            <input asp-for="Nombre_Completo" class="form-control" />
            <span asp-validation-for="Nombre_Completo" class="text-danger"></span>
        </div>

        <div class="col">
            <label asp-for="NIT" class="form-label">NIT</label>
            <input asp-for="NIT" class="form-control" />
            <span asp-validation-for="NIT" class="text-danger"></span>
        </div>

        <div class="col">
            <label class="form-label">Puesto</label>
            <select id="puestoSelect" class="form-control">
                <option value="">Seleccionar puesto</option>
                @foreach (var puesto in ViewBag.Puestos)
                {
                    <option value="@puesto">@puesto</option>
                }
            </select>
        </div>

        <div class="col" id="personaDiv" style="display:none;">
            <label for="personaSelect" class="form-label">Seleccionar puesto específico</label>
            <select id="personaSelect" class="form-control">
                <option value="">Seleccione un puesto específico</option>
            </select>
        </div>

        <input type="hidden" asp-for="Puesto" id="valorFinal" />

        <div class="col">
            <label asp-for="Unidad" class="form-label">Unidad</label>
            <select asp-for="Unidad" id="unidadSelect" class="form-control">
                <option value="">Seleccionar unidad</option>
                @foreach (var unidad in ViewBag.Unidades)
                {
                    <option value="@unidad">@unidad</option>
                }
            </select>
            <span asp-validation-for="Unidad" class="text-danger"></span>
        </div>

        <div class="col">
            <label asp-for="Tipo_Servicios" class="form-label">Tipo de servicios</label>
            <select asp-for="Tipo_Servicios" id="tipoServiciosSelect" class="form-control">
                <option value="">Seleccionar tipo de servicio</option>
                @foreach (var tipo in ViewBag.TipoServicios)
                {
                    <option value="@tipo">@tipo</option>
                }
            </select>
            <span asp-validation-for="Tipo_Servicios" class="text-danger"></span>
        </div>

        <div class="col">
            <label asp-for="Numero_Contrato" class="form-label">Número de contrato</label>
            <input asp-for="Numero_Contrato" class="form-control" />
            <span asp-validation-for="Numero_Contrato" class="text-danger"></span>
        </div>

        <div class="col">
            <label asp-for="Email" class="form-label">Correo electrónico</label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="col">
            <label asp-for="Password" class="form-label">Contraseña <em>(El usuario cambiará esta contraseña)</em></label>
            <input asp-for="Password" type="password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
    </div>

    <div class="pt-4">
        <button type="submit" class="btn btn-primary">Crear usuario</button>
        <a asp-action="List" class="btn btn-secondary">Cancelar</a>
    </div>
</form>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
<script>
    var puestoSelect = document.getElementById("puestoSelect");
    var personaDiv = document.getElementById("personaDiv");
    var personaSelect = document.getElementById("personaSelect");
    var valorFinal = document.getElementById("valorFinal");

    puestoSelect.addEventListener("change", function () {
        var valor = this.value.toLowerCase();
        personaSelect.innerHTML = ""; // limpiar opciones previas

        if (valor === "encargado") {
            personaDiv.style.display = "block";

            // Opción por defecto
            var defaultOpt = document.createElement("option");
            defaultOpt.value = "";
            defaultOpt.text = "Seleccione un puesto";
            defaultOpt.selected = true;
            defaultOpt.disabled = true;
            personaSelect.appendChild(defaultOpt);

            var encargados = [
                @foreach (var e in ViewBag.Encargados)
                {
                    @: "@e",
                }
            ];
            encargados.forEach(function (nombre) {
                var opt = document.createElement("option");
                opt.value = nombre;
                opt.text = nombre;
                personaSelect.appendChild(opt);
            });

            personaSelect.addEventListener("change", function () {
                valorFinal.value = this.value; // se envía la persona
            });

        } else if (valor === "auxiliar") {
            personaDiv.style.display = "block";

            // Opción por defecto
            var defaultOpt = document.createElement("option");
            defaultOpt.value = "";
            defaultOpt.text = "Seleccione un puesto";
            defaultOpt.selected = true;
            defaultOpt.disabled = true;
            personaSelect.appendChild(defaultOpt);

            var auxiliares = [
                @foreach (var a in ViewBag.Auxiliares)
                {
                    @: "@a",
                }
            ];
            auxiliares.forEach(function (nombre) {
                var opt = document.createElement("option");
                opt.value = nombre;
                opt.text = nombre;
                personaSelect.appendChild(opt);
            });

            personaSelect.addEventListener("change", function () {
                valorFinal.value = this.value; // se envía la persona
            });
        } else {
            personaDiv.style.display = "none";
            valorFinal.value = this.value;
        }
    });
</script>

}
