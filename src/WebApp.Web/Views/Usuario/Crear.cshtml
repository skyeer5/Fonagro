@model WebApp.Web.Models.Usuarios.UsuarioCreateViewModel;

@{
    ViewData["Title"] = "Crear Usuario";
}

<h2 class="text-xl font-semibold mb-4">Crear Usuario</h2>

<form asp-action="Crear" method="post" class="max-w-xl">
    <div class="row row-cols-1 row-cols-md-2 g-3">
        <div class="col">
            <label asp-for="Nombre_Completo" class="form-label">Nombre completo</label>
            <input asp-for="Nombre_Completo" class="form-control" required/>
            <span asp-validation-for="Nombre_Completo" class="text-danger"></span>
        </div>

        <div class="col">
            <label asp-for="NIT" class="form-label">NIT</label>
            <input asp-for="NIT" class="form-control" required/>
            <span asp-validation-for="NIT" class="text-danger"></span>
        </div>

        <div class="col">
            <label asp-for="Unidad" class="form-label">Unidad</label>
            <select asp-for="Unidad" id="UnidadId"
                asp-items="Model.Unidades"
                class="form-select">
                <option value="">Seleccione...</option>
            </select>
            <span asp-validation-for="Unidad" class="text-danger"></span>
        </div>

        <div class="col">
            <label asp-for="Puesto" class="form-label">Puesto</label>
            <select asp-for="Puesto"  id="PuestoId" class="form-select">
                <option>Seleccione un puesto</option>
            </select>
            <span asp-validation-for="Puesto" class="text-danger"></span>
        </div>

        <div class="col">
            <label asp-for="Tipo_Servicios" class="form-label">Tipo de Servicios</label>
            <select asp-for="Tipo_Servicios"
                asp-items="Model.TipoServicios"
                class="form-select">
                <option value="">Seleccione...</option>
            </select>
            <span asp-validation-for="Tipo_Servicios" class="text-danger"></span>
        </div>


        <div class="col">
            <label asp-for="Numero_Contrato" class="form-label">Número de contrato</label>
            <input asp-for="Numero_Contrato" class="form-control" required />
            <span asp-validation-for="Numero_Contrato" class="text-danger"></span>
        </div>

        <div class="col">
            <label asp-for="Email" class="form-label">Correo electrónico</label>
            <input asp-for="Email" type="email" class="form-control" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="col">
            <label asp-for="Password" class="form-label">Contraseña <em>(El usuario cambiará esta contraseña)</em></label>
            <input asp-for="Password" type="password" class="form-control" required />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
    </div>
    <!-- ERROR -->
    @if (TempData["msg"] != null)
    {
        <div class="alert alert-danger text-center py-2 mt-2 small">
            @TempData["msg"]
        </div>
    }
    <div class="pt-4">
        <button type="submit" class="btn btn-primary">Crear usuario</button>
        <a asp-action="List" class="btn btn-secondary">Cancelar</a>
    </div>
</form>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById("UnidadId")
        .addEventListener("change", async function () {

        const unidadId = this.value;

        const response = await fetch(
            `/Usuario/GetPuestosByUnidadId?unidadId=${unidadId}`);

        const puestos = await response.json();

        const combo = document.getElementById("PuestoId");

        combo.innerHTML = "";

        puestos.forEach(p => {

            combo.innerHTML +=
                `<option value="${p.id}">
                    ${p.nombre}
                </option>`;
        });
    });
    </script>
}
