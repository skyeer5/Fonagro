@using WebApp.Application.Usuarios.Queries.GetUsuariosActivosDetalle
@using WebApp.Domain.Usuarios
@model WebApp.Application.Core.PagedList<GetUsuariosActivosDetalleResponse>;
@{
    ViewData["Title"] = "Listado de usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Administración de Usuarios</h2>
        <a href="/Usuario/Crear" class="btn btn-success">
            <i class="bi bi-person-plus"></i> Nuevo Usuario
        </a>
    </div>
    <!-- Barra de búsqueda de usuarios -->
    <form action="/Usuario/List" method="get" class="mb-4">
        <div class="row g-3 align-items-end">
            <!-- Buscar por nombre -->
            <div class="col-md-3">
                <label for="nombre" class="form-label fw-bold">
                    <i class="bi bi-person-circle"></i> Nombre
                </label>
                <input type="text" 
                    class="form-control shadow-sm" 
                    id="nombre" 
                    name="nombre" 
                    placeholder="Ej. Juan Pérez">
            </div>

            <!-- Buscar por puesto -->
            <div class="col-md-3">
                <label for="puesto" class="form-label fw-bold">
                    <i class="bi bi-briefcase"></i> Puesto
                </label>
                <input type="text" 
                    class="form-control shadow-sm" 
                    id="puesto" 
                    name="puesto" 
                    placeholder="Ej. Encargado">
            </div>

            <!-- Buscar por unidad -->
            <div class="col-md-3">
                <label for="unidad" class="form-label fw-bold">
                    <i class="bi bi-building"></i> Unidad
                </label>
                <input type="text" 
                    class="form-control shadow-sm" 
                    id="unidad" 
                    name="unidad" 
                    placeholder="Ej. Unidad Administrativa">
            </div>

            <!-- Estado -->
            <div class="col-md-2">
                <label for="estado" class="form-label fw-bold">
                    <i class="bi bi-person-x"></i> Estado
                </label>
                <select name="Estado" id="estado" class="form-control">
                    <option value="">Seleccionar estado</option>
                    @foreach (var estado in ViewBag.Estados)
                    {
                        <option value="@estado">@estado</option>
                    }
                </select>
            </div>

            <!-- Botón de búsqueda -->
            <div class="col-md-1">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-search"></i> Buscar
                </button>
            </div>
        </div>
    </form>


    <!-- Tabla de usuarios -->
    <div class="table-responsive">
        <table class="table table-hover align-middle shadow-sm">
            <thead class="bg-azul">
                <tr>
                    <th><a class=" text-white text-decoration-none" href="/Usuario/List?orderBy=nombre">Nombre Completo</a></th>
                    <th class=" text-white">NIT</th>
                    <th><a class=" text-white text-decoration-none" href="/Usuario/List?orderBy=puesto">Puesto</a></th>
                    <th><a class=" text-white text-decoration-none" href="/Usuario/List?orderBy=unidad">Unidad</a></th>
                    <th>Estado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.Items)
                {
                    <tr>
                        <td>@item.Nombre_Completo</td>
                        <td>@item.NIT</td>
                        @* <td>@item.Puesto</td>
                        <td>@item.Unidad</td> *@
                        <td>
                            <span class="badge @(item.Estado == UsuarioEstados1.Activo ? "bg-success" : "bg-secondary")">
                                @item.Estado
                            </span>
                        </td>
                        <td class="text-center">
                            <a href="/Usuario/Edit?id=@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil-square"></i> Editar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/Usuario/List?currentPage=@(Model.CurrentPage != 1 ? Model.CurrentPage-1 : Model.CurrentPage)">Atrás</a>
            </li>
            @for(int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" href="/Usuario/List?currentPage=@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="/Usuario/List?currentPage=@(Model.CurrentPage != Model.TotalPages ? Model.CurrentPage+1 : Model.CurrentPage)">Siguiente</a>
            </li>
        </ul>
    </nav>

    <div class="mt-3">
        <a href="/Home/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Atrás
        </a>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
