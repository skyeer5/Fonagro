<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"]</title>
        <link rel="icon" type="image/png" href="~/img/hoja.ico">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/WebApp.Web.styles.css" asp-append-version="true" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
        <!-- jQuery primero -->
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

        <!-- Luego Select2 -->
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    </head>
    <body>
        <div class="app-layout">

            @if (User.Identity!.IsAuthenticated)
            {
                <aside class="sidebar">

                    <!-- Header usuario -->
                    <div class="sidebar-header">
                        <a href="@Url.Action("Index", "Home")">
                            <img src="~/img/fonagro.png" class="sidebar-logo" />
                        </a>

                        <div class="user-info">
                            <span class="user-label">Usuario autenticado con NIT</span>
                            <span class="user-name">@User.Identity.Name</span>
                        </div>
                    </div>

                    <!-- Menú -->
                    <nav class="sidebar-menu">
@* 
                        <a class="menu-item"
                        asp-controller="Home"
                        asp-action="Index">
                            Home
                        </a> *@

                        <!-- COMISIONES -->
                        <div class="menu-section">

                            <button class="menu-section-btn"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#comisionesMenu">
                                Comisiones
                            </button>

                            <div class="collapse" id="comisionesMenu">

                                <a class="submenu-item"
                                asp-controller="Comision"
                                asp-action="Index">
                                    Mi Comisión
                                </a>

                                <a class="submenu-item"
                                asp-controller="Comision"
                                asp-action="List">
                                    Ver Lista
                                </a>

                                <a class="submenu-item"
                                asp-controller="Comision"
                                asp-action="AprobarCombustible">
                                    Combustible
                                </a>

                                <a class="submenu-item"
                                asp-controller="Comision"
                                asp-action="Reporte">
                                    Generar reporte
                                </a>

                            </div>
                        </div>

                         <!-- NOMBRAMIENTOS -->
                        <div class="menu-section">

                            <button class="menu-section-btn"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#nombramientoMenu">
                                Nombramientos
                            </button>

                            <div class="collapse" id="nombramientoMenu">

                                <a class="submenu-item"
                                asp-controller="Nombramiento"
                                asp-action="List">
                                    Ver Lista
                                </a>

                            </div>
                        </div>

                        <!-- USUARIOS -->
                        <div class="menu-section">

                            <button class="menu-section-btn"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#usuariosMenu">
                                Usuarios
                            </button>

                            <div class="collapse" id="usuariosMenu">

                                <a class="submenu-item"
                                asp-controller="Usuario"
                                asp-action="List">
                                    Ver Lista
                                </a>

                            </div>
                        </div>

                        <!-- VEHICULOS -->
                        <div class="menu-section">

                            <button class="menu-section-btn"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#vehiculosMenu">
                                Vehículos
                            </button>

                            <div class="collapse" id="vehiculosMenu">

                                <a class="submenu-item"
                                asp-controller="Vehiculo"
                                asp-action="List">
                                    Ver Lista
                                </a>

                            </div>
                        </div>

                        <!-- COMBUSTIBLE -->
                        <div class="menu-section">

                            <button class="menu-section-btn"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#combustibleMenu">
                                Combustible
                            </button>

                            <div class="collapse" id="combustibleMenu">

                                <a class="submenu-item"
                                asp-controller="Combustible"
                                asp-action="UpdatePrecio">
                                    Actualizar Precio
                                </a>

                            </div>
                        </div>

                    </nav>

                    <!-- Footer sidebar -->
                    <div class="sidebar-footer">

                        <form asp-controller="Auth"
                            asp-action="Logout"
                            method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger w-100">
                                Cerrar sesión
                            </button>

                        </form>

                    </div>

                </aside>
            }

            <!-- CONTENIDO -->
            <div class="main-content">

                <main role="main" class="content-wrapper">
                    @RenderBody()
                </main>

            </div>

        </div>

        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
        <partial name="_Notificacion" />
        @await RenderSectionAsync("Scripts", required: false)

    </body>
</html>
