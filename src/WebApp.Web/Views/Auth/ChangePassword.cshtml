@model WebApp.Application.Authentication.Command.ChangePassword.ChangePasswordRequest  

@{
    ViewData["Title"] = "Cambiar contraseña";
}

<h2>Cambiar contraseña</h2>

<form asp-action="ChangePassword" method="post">
    <div class="form-group">
        <label asp-for="AnteriorPassword" class="control-label">Contraseña actual</label>
        <input asp-for="AnteriorPassword" type="password" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="Password" class="control-label">Nueva contraseña</label>
        <input asp-for="Password" type="password" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword" class="control-label">Confirmar nueva contraseña</label>
        <input asp-for="ConfirmPassword" type="password" class="form-control" required />
    </div>

    @if(TempData["msg"] != null)
    {
        <div class="alert alert-warning mt-2 form-group">
            @TempData["msg"]
        </div>
    }

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Cambiar contraseña</button>
    </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
