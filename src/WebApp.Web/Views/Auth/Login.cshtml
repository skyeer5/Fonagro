@model WebApp.Application.Authentication.Command.Login.LoginRequest

@{
    ViewData["Title"] = "Inicio de Sesión";
}

<div class="row justify-content-center mt-5">

    <div class="col-12 col-sm-8 col-md-5 col-lg-4">

        <div class="card shadow-sm border-0">

            <!-- HEADER -->
            <div class="card-header text-center bg-primary text-white shadow">
                <h3 class="mb-0 mt-1">Inicio de Sesión</h3>
                <small>Ingrese sus credenciales</small>
            </div>

            <!-- BODY -->
            <div class="card-body p-4">

                <form asp-action="Login" method="post">

                    <!-- NIT -->
                    <div class="mb-3">
                        <label asp-for="NIT" class="form-label">NIT</label>
                        <input asp-for="NIT" class="form-control" placeholder="Ingrese su NIT" required />
                        <span asp-validation-for="NIT" class="text-danger small"></span>
                    </div>

                    <!-- PASSWORD -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Ingrese su contraseña" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- ERROR -->
                    @if (TempData["msg"] != null)
                    {
                        <div class="alert alert-danger text-center py-2 small">
                            @TempData["msg"]
                        </div>
                    }

                    <!-- BUTTON -->
                    <div class="d-grid mt-3">
                        <button type="submit" class="btn btn-primary">
                            Ingresar
                        </button>
                    </div>

                </form>

            </div>

        </div>

    </div>

</div>