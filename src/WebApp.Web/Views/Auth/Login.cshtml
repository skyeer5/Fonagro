@model WebApp.Application.Authentication.Command.Login.LoginRequest

@{
    ViewData["Title"] = "Login";
}

<h2>Inicio de Sesión</h2>

<form asp-action="Login" method="post">
    <div class="form-group">
        <label asp-for="NIT" class="control-label"></label>
        <input asp-for="NIT" class="form-control" required />
        <span asp-validation-for="NIT" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password" class="control-label">Contraseña</label>
        <input asp-for="Password" type="password" class="form-control" required />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    
    @if(TempData["msg"]!=null)
    {
        <div class="alert mt-3 alert-danger">
            @TempData["msg"]
        </div>
    }

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Ingresar</button>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
