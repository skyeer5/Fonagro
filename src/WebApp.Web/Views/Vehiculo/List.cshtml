@using WebApp.Application.Vehiculos.Queries.GetVehiculosDetalle
@using WebApp.Domain
@model WebApp.Application.Core.PagedList<GetVehiculosDetalleResponse>;
@{
    ViewData["Title"] = "Listado de Vehículos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Administración de Vehículos</h2>
        <a href="/Vehiculo/Crear" class="btn btn-success">
            <i class="bi bi-car"></i> Nuevo Vehículo
        </a>
    </div>

    <!-- Barra de búsqueda de vehículos -->
    <form action="/Vehiculo/List" method="get" class="mb-4">
        <div class="row g-3 align-items-end">
            <!-- Marca -->
            <div class="col-md-3">
                <label for="marca" class="form-label fw-bold">
                    <i class="bi bi-car-front"></i> Marca
                </label>
                <input type="text" 
                    class="form-control shadow-sm" 
                    id="marca" 
                    name="marca" 
                    placeholder="Ej. Toyota">
            </div>

            <!-- Modelo -->
            <div class="col-md-3">
                <label for="modelo" class="form-label fw-bold">
                    <i class="bi bi-card-list"></i> Modelo
                </label>
                <input type="text" 
                    class="form-control shadow-sm" 
                    id="modelo" 
                    name="modelo" 
                    placeholder="Ej. Hilux">
            </div>

            <!-- Placa -->
            <div class="col-md-3">
                <label for="placa" class="form-label fw-bold">
                    <i class="bi bi-upc-scan"></i> Placa
                </label>
                <input type="text" 
                    class="form-control shadow-sm" 
                    id="placa" 
                    name="placa" 
                    placeholder="Ej. P-123ABC">
            </div>

            <!-- Estado -->
            <div class="col-md-2">
                <label for="estado" class="form-label fw-bold">
                    <i class="bi bi-tag"></i> Estado
                </label>
                <select name="estado" id="estado" class="form-control">
                    <option value="">Seleccionar estado</option>
                    @foreach (var estado in ViewBag.Estados)
                    {
                        <option value="@estado">@estado</option>
                    }
                </select>
            </div>

            <!-- Botón de búsqueda -->
            <div class="col-md-1">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-search"></i> Buscar
                </button>
            </div>
        </div>
    </form>

    <!-- Tabla de vehículos -->
    <div class="table-responsive">
        <table class="table table-hover align-middle shadow-sm">
            <thead class="bg-azul">
                <tr>
                    <th><a class=" text-white text-decoration-none" href="/Vehiculo/List?orderBy=marca">Marca</a></th>
                    <th><a class=" text-white text-decoration-none" href="/Vehiculo/List?orderBy=modelo">Modelo</a></th>
                    <th><a class=" text-white text-decoration-none" href="/Vehiculo/List?orderBy=placa">Placa</a></th>
                    <th>Estado</th>
                    <th class="text-center">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model.Items)
                {
                    <tr>
                        <td>@item.Marca</td>
                        <td>@item.Modelo</td>
                        <td>@item.Placa</td>
                        <td>
                            <span class="badge @(item.Estado == EstadosTipos.Disponible ? "bg-success" : "bg-secondary")">
                                @item.Estado
                            </span>
                        </td>
                        <td class="text-center">
                            <a href="/Vehiculo/Edit?id=@item.VehiculoId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil-square"></i> Editar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/Vehiculo/List?currentPage=@(Model.CurrentPage != 1 ? Model.CurrentPage-1 : Model.CurrentPage)">Atrás</a>
            </li>
            @for(int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" href="/Vehiculo/List?currentPage=@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="/Vehiculo/List?currentPage=@(Model.CurrentPage != Model.TotalPages ? Model.CurrentPage+1 : Model.CurrentPage)">Siguiente</a>
            </li>
        </ul>
    </nav>

    <div class="mt-3">
        <a href="/Libro/Add" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Atrás
        </a>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
