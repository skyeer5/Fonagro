@model WebApp.Web.Models.Vehiculos.VehiculoCreateViewModel

@{
    ViewData["Title"] = "Crear Vehículo";
}

<h2>Crear Vehículo</h2>

<form asp-action="Crear" method="post" class="mt-3">
    
    <div class="row">

        <!-- ================= LEFT COLUMN ================= -->
<div class="card mb-3">
    <div class="card-header">Datos Básicos</div>
    <div class="card-body">
        <div class="row">

            <div class="col-md-6 mb-3">
                <label asp-for="Placa" class="form-label"></label>
                <input asp-for="Placa" class="form-control" required/>
                <span asp-validation-for="Placa" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Marca" class="form-label"></label>
                <input asp-for="Marca" class="form-control" required/>
                <span asp-validation-for="Marca" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Modelo" class="form-label"></label>
                <input asp-for="Modelo" class="form-control" required/>
                <span asp-validation-for="Modelo" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Anio" class="form-label">Año</label>
                <input asp-for="Anio" type="number" class="form-control" required/>
                <span asp-validation-for="Anio" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Tipo_Vehiculo" class="form-label"></label>
                <select asp-for="Tipo_Vehiculo" asp-items="Model.Tipos" class="form-control" required>
                    <option value="">--Seleccionar--</option>
                </select>
                <span asp-validation-for="Tipo_Vehiculo" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Color" class="form-label"></label>
                <input asp-for="Color" class="form-control" required/>
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Cilindraje" class="form-label"></label>
                <select asp-for="Cilindraje" asp-items="Model.Cilindrajes" class="form-control" required>
                    <option value="">--Seleccionar--</option>
                </select>
                <span asp-validation-for="Cilindraje" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label>Combustible</label>
                <select class="form-select mt-2" asp-for="GasolinaId" asp-items="Model.Gasolinas" required>
                    <option value="">--Seleccionar--</option>
                </select>
                <span asp-validation-for="GasolinaId" class="text-danger"></span>
            </div>

        </div>
    </div>
</div>

    <!-- BOTÓN -->
    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}